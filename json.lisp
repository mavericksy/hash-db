;;;; JSON: a column type and an expression to read inside it.
;;;;
;;;;   (make-table "docs" '((:id primary-key-column) (:body json)))
;;;;   (insert-row (list :body "{\"name\": \"ann\", \"tags\": [\"a\", \"b\"]}") "docs")
;;;;   (select :from "docs" :where '(= (json-get :body "name") "ann"))
;;;;   (select :from "docs" :col '((as (json-get :body "tags" 0) :first-tag)))
;;;;
;;;; A json column holds JSON text. It is checked when a row is written and kept in
;;;; compact form, so equal documents give equal text, and unique, index and group-by
;;;; work on it as on any string. Key order is kept as written.
;;;;
;;;; (json-get doc path ...) goes down the path. A path step is a string for an
;;;; object key or a whole number for an array place that counts from 0. It gives the
;;;; value: a string, a number, t, nil, or :null. For an object or an array, it gives
;;;; its JSON text. A missing step gives :null.
;;;;
;;;; JSON data in Lisp is: an object (:object ("key" . value) ...), an array as a vector,
;;;; a string, an integer or double-float, and :true, :false and :null.

(in-package :hash-db)

(defun json-fail (format-control &rest args)
  (error 'json-error :message (apply #'format nil format-control args)))

;;; Reading

(defparameter *json-max-depth* 512)

(defun json-decode (text)
  "Read JSON text. Signal json-error if it is not valid."
  (unless (stringp text)
    (json-fail "JSON text must be a string, got ~S" text))
  (let ((pos 0)
        (end (length text)))
    (labels ((fail (what)
               (json-fail "Not JSON: ~A at character ~D" what pos))
             (peek ()
               (and (< pos end) (char text pos)))
             (next ()
               (prog1 (or (peek) (fail "text ends too soon"))
                 (incf pos)))
             (skip-space ()
               (loop while (and (< pos end) (member (char text pos) '(#\Space #\Tab #\Newline #\Return)))
                     do (incf pos)))
             (expect (word value)
               (if (and (<= (+ pos (length word)) end)
                        (string= word text :start2 pos :end2 (+ pos (length word))))
                   (progn (incf pos (length word)) value)
                   (fail (format nil "expected ~A" word))))
             (value (depth)
               (when (> depth *json-max-depth*)
                 (fail "too deeply nested"))
               (skip-space)
               (let ((c (peek)))
                 (case c
                   ((nil) (fail "text ends too soon"))
                   (#\{ (object depth))
                   (#\[ (array depth))
                   (#\" (string-value))
                   (#\t (expect "true" :true))
                   (#\f (expect "false" :false))
                   (#\n (expect "null" :null))
                   (t (if (or (char= c #\-) (digit-char-p c))
                          (number-value)
                          (fail (format nil "unexpected ~S" c)))))))
             (object (depth)
               (incf pos)
               (skip-space)
               (let ((members '()))
                 (if (eql (peek) #\})
                     (incf pos)
                     (loop
                       (skip-space)
                       (unless (eql (peek) #\")
                         (fail "expected a key"))
                       (let ((key (string-value)))
                         (skip-space)
                         (unless (eql (next) #\:)
                           (decf pos)
                           (fail "expected :"))
                         (push (cons key (value (1+ depth))) members))
                       (skip-space)
                       (let ((c (next)))
                         (cond ((char= c #\,))
                               ((char= c #\}) (return))
                               (t (decf pos) (fail "expected , or }"))))))
                 (cons :object (nreverse members))))
             (array (depth)
               (incf pos)
               (skip-space)
               (let ((items '()))
                 (if (eql (peek) #\])
                     (incf pos)
                     (loop
                       (push (value (1+ depth)) items)
                       (skip-space)
                       (let ((c (next)))
                         (cond ((char= c #\,))
                               ((char= c #\]) (return))
                               (t (decf pos) (fail "expected , or ]"))))))
                 (coerce (nreverse items) 'simple-vector)))
             (hex4 ()
               (when (> (+ pos 4) end)
                 (fail "a \\u escape needs 4 digits"))
               (let ((code (parse-integer text :start pos :end (+ pos 4) :radix 16 :junk-allowed t)))
                 (unless (and code (every #'(lambda (c) (digit-char-p c 16)) (subseq text pos (+ pos 4))))
                   (fail "a \\u escape needs 4 hex digits"))
                 (incf pos 4)
                 code))
             (string-value ()
               (incf pos)
               (let ((out (make-string-output-stream)))
                 (loop
                   (let ((c (next)))
                     (cond ((char= c #\") (return))
                           ((char< c #\Space) (decf pos) (fail "a control character in a string"))
                           ((char= c #\\)
                            (let ((e (next)))
                              (case e
                                (#\" (write-char #\" out))
                                (#\\ (write-char #\\ out))
                                (#\/ (write-char #\/ out))
                                (#\b (write-char #\Backspace out))
                                (#\f (write-char #\Page out))
                                (#\n (write-char #\Newline out))
                                (#\r (write-char #\Return out))
                                (#\t (write-char #\Tab out))
                                (#\u (let ((code (hex4)))
                                       (cond ((<= #xD800 code #xDBFF)
                                              (unless (and (eql (peek) #\\)
                                                           (< (1+ pos) end)
                                                           (char= (char text (1+ pos)) #\u))
                                                (fail "a high surrogate needs a low one"))
                                              (incf pos 2)
                                              (let ((low (hex4)))
                                                (unless (<= #xDC00 low #xDFFF)
                                                  (fail "a high surrogate needs a low one"))
                                                (write-char (code-char (+ #x10000
                                                                          (ash (- code #xD800) 10)
                                                                          (- low #xDC00)))
                                                            out)))
                                             ((<= #xDC00 code #xDFFF) (fail "a lone low surrogate"))
                                             (t (write-char (code-char code) out)))))
                                (t (decf pos) (fail "a bad escape")))))
                           (t (write-char c out)))))
                 (get-output-stream-string out)))
             (number-value ()
               (let ((start pos))
                 (when (eql (peek) #\-) (incf pos))
                 (cond ((eql (peek) #\0) (incf pos))
                       ((and (peek) (digit-char-p (peek)))
                        (loop while (and (peek) (digit-char-p (peek))) do (incf pos)))
                       (t (fail "a digit was expected")))
                 (let ((integer-end pos) (fraction nil))
                   (when (eql (peek) #\.)
                     (incf pos)
                     (unless (and (peek) (digit-char-p (peek))) (fail "a digit was expected after ."))
                     (loop while (and (peek) (digit-char-p (peek))) do (incf pos))
                     (setf fraction t))
                   (when (member (peek) '(#\e #\E))
                     (incf pos)
                     (when (member (peek) '(#\+ #\-)) (incf pos))
                     (unless (and (peek) (digit-char-p (peek))) (fail "a digit was expected in the exponent"))
                     (loop while (and (peek) (digit-char-p (peek))) do (incf pos))
                     (setf fraction t))
                   (if fraction
                       (let ((*read-default-float-format* 'double-float))
                         (handler-case (let ((x (let ((*read-eval* nil))
                                                  (read-from-string (substitute #\d #\E (substitute #\d #\e (subseq text start pos)))))))
                                         (coerce x 'double-float))
                           (error () (fail "a number out of range"))))
                       (parse-integer text :start start :end integer-end))))))
      (let ((result (value 0)))
        (skip-space)
        (when (< pos end)
          (fail "text after the value"))
        result))))

;;; Writing

(defun json-write-string (string out)
  (write-char #\" out)
  (loop for c across string
        do (case c
             (#\" (write-string "\\\"" out))
             (#\\ (write-string "\\\\" out))
             (#\Newline (write-string "\\n" out))
             (#\Return (write-string "\\r" out))
             (#\Tab (write-string "\\t" out))
             (#\Backspace (write-string "\\b" out))
             (#\Page (write-string "\\f" out))
             (t (if (char< c #\Space)
                    (format out "\\u~4,'0X" (char-code c))
                    (write-char c out)))))
  (write-char #\" out))

(defun json-write (data out)
  (cond ((or (eq data :true) (eq data t)) (write-string "true" out))
        ((or (eq data :false) (null data)) (write-string "false" out))
        ((eq data :null) (write-string "null" out))
        ((stringp data) (json-write-string data out))
        ((integerp data) (format out "~D" data))
        ((floatp data)
         (when (or (/= data data) (> (abs data) most-positive-double-float))
           (json-fail "JSON has no infinity or NaN"))
         (let ((*read-default-float-format* 'double-float))
           (write-string (prin1-to-string (coerce data 'double-float)) out)))
        ((rationalp data) (json-write (coerce data 'double-float) out))
        ((and (consp data) (eq (first data) :object))
         (write-char #\{ out)
         (loop for (pair . more) on (rest data)
               do (unless (and (consp pair) (stringp (car pair)))
                    (json-fail "An object member is (\"key\" . value), got ~S" pair))
                  (json-write-string (car pair) out)
                  (write-char #\: out)
                  (json-write (cdr pair) out)
                  (when more (write-char #\, out)))
         (write-char #\} out))
        ((and (vectorp data) (not (stringp data)))
         (write-char #\[ out)
         (loop for i from 0 below (length data)
               do (when (plusp i) (write-char #\, out))
                  (json-write (aref data i) out))
         (write-char #\] out))
        (t (json-fail "Can't write ~S as JSON" data))))

(defun json-encode (data)
  "Write JSON data as compact text."
  (with-output-to-string (out)
    (json-write data out)))

;;; The column type

(defun normalise-json (text col)
  (handler-case (json-encode (json-decode text))
    (json-error (c)
      (error 'type-mismatch :column (name col)
                            :message (format nil "Column ~A needs JSON text. ~A" (name col) (error-message c))))))

(make-class-specific-col :class column
                         :type json
                         :value-type string
                         :comparator #'string<
                         :eq-pred #'string=
                         :val-norm #'normalise-json)

;;; json-get

(defun json-step (data step)
  (cond ((and (consp data) (eq (first data) :object) (stringp step))
         (let ((member (find step (rest data) :key #'car :test #'string= :from-end t)))
           (if member (cdr member) :null)))
        ((and (simple-vector-p data) (integerp step))
         (if (< -1 step (length data)) (aref data step) :null))
        (t :null)))

;; The value of DATA as a database value.
(defun json-value (data)
  (cond ((eq data :true) t)
        ((eq data :false) nil)
        ((or (stringp data) (numberp data) (eq data :null)) data)
        (t (json-encode data))))

(define-op "JSON-GET" (args ctx)
  (check-arity "JSON-GET" args 1 nil)
  (let ((fns (compile-args args ctx)))
    #'(lambda (row)
        (let ((values (call-all fns row)))
          (if (some #'nullish-p values)
              :null
              (let ((data (handler-case (json-decode (first values))
                            (json-error (c) (bad-expression "JSON-GET: ~A" (error-message c))))))
                (dolist (step (rest values))
                  (setf data (json-step data step))
                  (when (eq data :null) (return)))
                (json-value data)))))))
