(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defun q (text &rest params)
  (apply #'sql-rows text params))

;;; the same rows as select

(def-test sql-select-star-and-columns (:fixture clean-db)
  (make-sample-people)
  (is (equal (row-list "people") (q "SELECT * FROM people")))
  (is (equal (row-list "people") (q "select * from People;")))
  (is (equal '((:name "ann" :age 30) (:name "bob" :age 25))
             (q "SELECT name, age FROM people WHERE id <= 2 ORDER BY id")))
  (is (equal '((:name "ann")) (q "SELECT p.name FROM people AS p WHERE p.id = 1")))
  (is (equal '((:name "ann")) (q "SELECT p.name FROM people p WHERE id = 1")) "an alias without AS")
  (is (equal '((:id 1 :name "ann" :age 30 :active t)) (q "SELECT p.* FROM people p WHERE p.id = 1"))
      "p.* is every column of p"))

(def-test sql-select-where-order-limit (:fixture clean-db)
  (make-sample-people)
  (is (equal '("ann" "cat") (mapcar (lambda (r) (getf r :name))
                                    (q "SELECT name FROM people WHERE age = ? ORDER BY name" 30))))
  (is (equal '("Eve" "ann") (mapcar (lambda (r) (getf r :name))
                                    (q "SELECT name FROM people WHERE age IS NOT NULL ORDER BY age DESC, id LIMIT 2"))))
  (is (equal '("cat" "ann") (mapcar (lambda (r) (getf r :name))
                                    (q "SELECT name FROM people WHERE age IS NOT NULL ORDER BY age DESC, id DESC LIMIT 2 OFFSET 1"))))
  (is (equal '("dan") (mapcar (lambda (r) (getf r :name)) (q "SELECT name FROM people ORDER BY age LIMIT 1 OFFSET 4"))))
  (is (equal '("dan" "Eve") (mapcar (lambda (r) (getf r :name))
                                    (q "SELECT name FROM people ORDER BY age DESC NULLS FIRST LIMIT 2"))))
  (is (equal '("Eve") (mapcar (lambda (r) (getf r :name))
                              (q "SELECT name FROM people ORDER BY age DESC NULLS LAST LIMIT ?" 1)))))

(def-test sql-select-distinct-and-expressions (:fixture clean-db)
  (make-sample-people)
  (is (equal '((:age 30) (:age 25) (:age :null) (:age 41))
             (q "SELECT DISTINCT age FROM people ORDER BY id")))
  (is (equal '((:name "ann" :next 31)) (q "SELECT name, age + 1 AS next FROM people WHERE id = 1")))
  (is (equal '((:expr2 "ANN")) (mapcar (lambda (r) (list :expr2 (getf r :expr2)))
                                       (q "SELECT name, upper(name) FROM people WHERE id = 1"))))
  (is (equal '((:n 5)) (q "SELECT count(*) AS n FROM people")))
  (is (equal '((:n 4)) (q "SELECT count(age) AS n FROM people")))
  (is (equal '((:a "x")) (q "SELECT 'x' AS a FROM people LIMIT 1"))))

(def-test sql-select-group-by-having-order-by-alias (:fixture clean-db)
  (make-sales)
  (is (equal '((:dept "toys" :total 60) (:dept "food" :total 20) (:dept :null :total 7) (:dept "misc" :total :null))
             (q "SELECT dept, sum(amount) AS total FROM sales GROUP BY dept ORDER BY total DESC")))
  (is (equal '((:dept "toys" :n 3) (:dept "food" :n 2))
             (q "SELECT dept, count(*) AS n FROM sales GROUP BY dept HAVING count(*) >= 2 ORDER BY n DESC")))
  (is (equal '((:dept "toys" :n 3))
             (q "SELECT dept, count(*) AS n FROM sales GROUP BY dept HAVING n > 2")) "an alias in HAVING")
  (is (equal '((:mean 20)) (mapcar (lambda (r) (list :mean (getf r :mean)))
                                   (q "SELECT sum(amount) / count(amount) AS mean FROM sales WHERE dept = 'toys'"))))
  (is (equal '((:cities 3)) (q "SELECT count(DISTINCT city) AS cities FROM sales")))
  (is (equal '((:c "oslo" :d "toys" :n 2) (:c "paris" :d "toys" :n 1))
             (q "SELECT city AS c, dept AS d, count(*) AS n FROM sales WHERE dept = 'toys' GROUP BY city, dept ORDER BY city"))))

(def-test sql-select-default-names (:fixture clean-db)
  (make-sales)
  (is (equal '((:count 7 :sum-amount 87 :max-amount 30 :min-amount 5))
             (q "SELECT count(*), sum(amount), max(amount), min(amount) FROM sales"))))

(def-test sql-select-matches-the-hand-written-select (:fixture clean-db)
  (make-sample-people)
  (is (equal (row-list (select :from "people" :where '(and (>= :age 25) (like :name "%a%")) :order-by '((desc :age) :id)
                               :col '(:name :age) :limit 3))
             (q "SELECT name, age FROM people WHERE age >= 25 AND name LIKE '%a%' ORDER BY age DESC, id LIMIT 3"))))

(def-test sql-select-on-views-and-case-of-names (:fixture clean-db)
  (make-sample-people)
  (create-view "old" :from "people" :where '(>= :age 30) :col '(:id :name))
  (is (equal '("ann" "cat" "Eve") (mapcar (lambda (r) (getf r :name)) (q "SELECT name FROM old ORDER BY id"))))
  (make-table "Mixed" '((:id primary-key-column) (:v integer)))
  (insert-row '(:v 1) "Mixed")
  (is (equal '((:v 1)) (q "SELECT v FROM mixed")) "a table with capitals is found when no other matches")
  (is (equal '((:v 1)) (q "SELECT v FROM \"Mixed\"")))
  (signals no-such-table (q "SELECT v FROM \"mixed\"") ))

(def-test sql-select-uses-indexes (:fixture clean-db)
  (make-sample-people)
  (create-index "people" :age)
  (let ((args (hash-db::translate-select (first (hash-db::sql-parse "SELECT name FROM people WHERE age = 30 AND name LIKE 'a%'")))))
    (is (equal '(:index :eq)
               (let ((step (first (apply #'explain args))))
                 (list (getf (cddr step) :access) (getf (cddr step) :op)))))))

(def-test sql-select-parameters-are-data (:fixture clean-db)
  (make-sample-people)
  (is (equal '() (q "SELECT name FROM people WHERE name = ?" "x' OR 1=1 --")))
  (is (equal '(("ann")) (mapcar (lambda (r) (list (getf r :name))) (q "SELECT name FROM people WHERE name = ? AND age = ?" "ann" 30))))
  (signals sql-error (q "SELECT name FROM people WHERE age = ?"))
  (signals sql-error (q "SELECT name FROM people WHERE age = ?" 1 2))
  (signals sql-error (q "SELECT name FROM people LIMIT ?" -1))
  (signals sql-error (q "SELECT name FROM people LIMIT ?" "x")))

(def-test sql-select-errors (:fixture clean-db)
  (make-sample-people)
  (flet ((fails (text &rest params)
           (handler-case (progn (apply #'sql text params) nil)
             (sql-error (c) (error-message c)))))
    (is (search "Expected FROM" (fails "SELECT 1")))
    (is (search "Expected FROM" (fails "SELECT name")))
    (is (search "list of tables" (fails "SELECT * FROM people, pets")))
    (is (search "Set operations" (fails "SELECT id FROM people UNION SELECT id FROM people")))
    (is (search "column number" (fails "SELECT name FROM people ORDER BY 1")))
    (is (search "Unknown column nope" (fails "SELECT nope FROM people")))
    (is (search "Unknown column nope" (fails "SELECT name FROM people WHERE nope = 1")))
    (is (search "Unknown table or alias x" (fails "SELECT x.name FROM people")))
    (is (search "Unexpected text" (fails "SELECT name FROM people garbage garbage")))
    (is (search "one statement" (fails "SELECT name FROM people; SELECT name FROM people")))
    (is (search "not supported" (fails "FROBNICATE people")))
    (is (search "no statement" (fails "  ; ")))
    (is (search "Expected a table name" (fails "SELECT name FROM")))
    (is (search "whole number" (fails "SELECT name FROM people LIMIT 1.5")))
    (signals no-such-table (sql "SELECT name FROM nope"))
    (signals query-error (sql "SELECT name FROM people WHERE count(*) > 1"))
    (signals query-error (sql "SELECT name, count(*) FROM people"))))

(def-test sql-select-runs-in-a-snapshot-and-transaction (:fixture clean-db)
  (make-sample-people)
  (with-transaction
    (insert-row '(:name "zed" :age 1) "people")
    (is (= 6 (length (q "SELECT * FROM people")))))
  (is (equal '() (let ((hash-db::*as-of* nil)) (q "SELECT name FROM people WHERE name = 'nobody'")))))
