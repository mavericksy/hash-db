(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defun ast (text) (values (hash-db::sql-parse-expression text)))

;;; the tree

(def-test sql-parses-literals-and-names (:fixture clean-db)
  (is (equal '(:lit 42) (ast "42")))
  (is (equal '(:lit 1.5d0) (ast "1.5")))
  (is (equal '(:lit "it's") (ast "'it''s'")))
  (is (equal '(:lit t) (ast "true")))
  (is (equal '(:lit nil) (ast "FALSE")))
  (is (equal '(:lit :null) (ast "null")))
  (is (equal '(:col nil "age") (ast "age")))
  (is (equal '(:col "p" "age") (ast "p.age")))
  (is (equal '(:col nil "My Col") (ast "\"My Col\"")))
  (is (equal '(:col "t" "x") (ast "\"t\".\"x\"")))
  (is (equal '(:param 0) (ast "?")))
  (is (equal '(:lit -5) (ast "-5")) "a minus sign in front of a number is part of it"))

(def-test sql-parses-with-the-usual-precedence (:fixture clean-db)
  (is (equal '(:op "OR" (:col nil "a") (:op "AND" (:col nil "b") (:col nil "c")))
             (ast "a OR b AND c")))
  (is (equal '(:op "AND" (:op "OR" (:col nil "a") (:col nil "b")) (:col nil "c"))
             (ast "(a OR b) AND c")))
  (is (equal '(:op "NOT" (:op "=" (:col nil "a") (:lit 1))) (ast "NOT a = 1")))
  (is (equal '(:op "+" (:lit 1) (:op "*" (:lit 2) (:lit 3))) (ast "1 + 2 * 3")))
  (is (equal '(:op "-" (:op "-" (:lit 1) (:lit 2)) (:lit 3)) (ast "1 - 2 - 3")) "left to right")
  (is (equal '(:op "=" (:op "+" (:col nil "a") (:lit 1)) (:lit 2)) (ast "a + 1 = 2")))
  (is (equal '(:op "||" (:col nil "a") (:lit "x")) (ast "a || 'x'")))
  (is (equal '(:op "NEG" (:col nil "a")) (ast "-a")))
  (is (equal '(:col nil "a") (ast "+a")))
  (is (equal '(:op "<>" (:col nil "a") (:lit 1)) (ast "a != 1")))
  (is (equal '(:op "<>" (:col nil "a") (:lit 1)) (ast "a <> 1"))))

(def-test sql-parses-predicates (:fixture clean-db)
  (is (equal '(:is-null (:col nil "a") nil) (ast "a IS NULL")))
  (is (equal '(:is-null (:col nil "a") t) (ast "a IS NOT NULL")))
  (is (equal '(:in (:col nil "a") ((:lit 1) (:lit 2)) nil) (ast "a IN (1, 2)")))
  (is (equal '(:in (:col nil "a") ((:lit 1)) t) (ast "a NOT IN (1)")))
  (is (equal '(:between (:col nil "a") (:lit 1) (:lit 5) nil) (ast "a BETWEEN 1 AND 5")))
  (is (equal '(:op "AND" (:between (:col nil "a") (:lit 1) (:lit 5) t) (:col nil "b"))
             (ast "a NOT BETWEEN 1 AND 5 AND b")) "the AND of BETWEEN belongs to it")
  (is (equal '(:like (:col nil "n") (:lit "a%") nil) (ast "n LIKE 'a%'")))
  (is (equal '(:like (:col nil "n") (:lit "a%") t) (ast "n NOT LIKE 'a%'"))))

(def-test sql-parses-calls-and-parameters (:fixture clean-db)
  (is (equal '(:call "LOWER" ((:col nil "n")) nil nil) (ast "lower(n)")))
  (is (equal '(:call "COUNT" nil nil t) (ast "count(*)")))
  (is (equal '(:call "COUNT" ((:col nil "n")) t nil) (ast "COUNT(DISTINCT n)")))
  (is (equal '(:call "COALESCE" ((:col nil "a") (:lit 0)) nil nil) (ast "coalesce(a, 0)")))
  (is (equal '(:call "NOW" nil nil nil) (ast "now()")))
  (is (equal '(:call "NOW" nil nil nil) (ast "CURRENT_TIMESTAMP")))
  (multiple-value-bind (tree count) (hash-db::sql-parse-expression "a = ? AND b IN (?, ?)")
    (is (= 3 count))
    (is (equal '(:op "AND" (:op "=" (:col nil "a") (:param 0))
                 (:in (:col nil "b") ((:param 1) (:param 2)) nil))
               tree))))

(def-test sql-expression-errors-say-where (:fixture clean-db)
  (flet ((fails (text)
           (handler-case (progn (ast text) nil)
             (sql-error (c) (list (error-position c) (error-message c))))))
    (is (equal 4 (first (fails "a = ")))  "the end of the text")
    (is (search "Expected an expression" (second (fails "a = "))))
    (is (equal 2 (first (fails "a )"))) )
    (is (search "Unexpected text" (second (fails "a b"))))
    (is (search "Expected FROM" (second (fails "a IN (SELECT 1)"))) "a subquery is read, and needs FROM")
    (is (search "Expected SELECT after EXISTS" (second (fails "EXISTS (1)"))))
    (is (null (fails "CASE WHEN a THEN b END")) "CASE is supported now")
    (is (equal '(:case nil (((:col nil "a") (:col nil "b"))) (:lit 0))
               (ast "CASE WHEN a THEN b ELSE 0 END")))
    (is (equal '(:case (:col nil "x") (((:lit 1) (:lit "one")) ((:lit 2) (:lit "two"))) nil)
               (ast "CASE x WHEN 1 THEN 'one' WHEN 2 THEN 'two' END")))
    (is (search "DISTINCT works only inside COUNT" (second (fails "sum(DISTINCT a)"))))
    (is (search "ESCAPE" (second (fails "a LIKE 'x' ESCAPE '!'"))))
    (is (fails "a AND"))
    (is (fails "(a"))
    (is (fails "a IN ()"))
    (is (fails "a IN (1,"))
    (is (fails "a BETWEEN 1"))
    (is (fails "a IS 5"))
    (is (fails "SELECT"))
    (is (fails ""))
    (is (null (fails "a;")) "a closing semicolon is fine")))

;;; into expressions of hash-db

(defun dsl (text &rest params)
  (apply #'sql-expression text "people" params))

(def-test sql-translates-to-the-expression-language (:fixture clean-db)
  (make-people)
  (is (equal '(:= :age 30) (dsl "age = 30")))
  (is (equal '(:/= :age 30) (dsl "age <> 30")))
  (is (equal '(:and (:>= :age 18) (:< :age 65) (:is-not-null :name)) (dsl "age >= 18 AND age < 65 AND name IS NOT NULL"))
      "nested AND becomes one AND")
  (is (equal '(:or (:= :age 1) (:= :age 2) (:= :age 3)) (dsl "age = 1 OR age = 2 OR age = 3")))
  (is (equal '(:and (:or (:= :age 1) (:= :age 2)) :active) (dsl "(age = 1 OR age = 2) AND active")))
  (is (equal '(:not (:= :age 1)) (dsl "NOT age = 1")))
  (is (equal '(:not (:in :age 1 2)) (dsl "age NOT IN (1, 2)")))
  (is (equal '(:between :age 1 5) (dsl "age BETWEEN 1 AND 5")))
  (is (equal '(:not (:between :age 1 5)) (dsl "age NOT BETWEEN 1 AND 5")))
  (is (equal '(:like :name "a%") (dsl "name LIKE 'a%'")))
  (is (equal '(:not (:like :name "a%")) (dsl "name NOT LIKE 'a%'")))
  (is (equal '(:is-null :age) (dsl "age IS NULL")))
  (is (equal '(:= (:+ :age 1) 31) (dsl "age + 1 = 31")))
  (is (equal '(:= (:- :age) -30) (dsl "-age = -30")))
  (is (equal '(:= (:concat :name "!") "ann!") (dsl "name || '!' = 'ann!'")))
  (is (equal '(:= (:lower :name) "ann") (dsl "LOWER(name) = 'ann'")))
  (is (equal '(:= (:length :name) 3) (dsl "char_length(name) = 3")))
  (is (equal '(:coalesce :age 0) (dsl "coalesce(age, 0)")))
  (is (equal '(:count) (dsl "count(*)")))
  (is (equal '(:count-distinct :name) (dsl "count(distinct name)")))
  (is (equal '(:sum :age) (dsl "sum(age)")))
  (is (equal '(:json-get :name "a" 0) (dsl "json_get(name, 'a', 0)")))
  (is (equal (list :> :age (list :fn 'hash-db::now)) (dsl "age > now()")))
  (is (equal :null (dsl "NULL")))
  (is (equal t (dsl "TRUE"))))

(def-test sql-names-find-their-columns (:fixture clean-db)
  (make-people)
  (is (equal '(:= :age 1) (dsl "AGE = 1")) "names are not case sensitive")
  (is (equal '(:= :age 1) (dsl "people.age = 1")))
  (is (equal '(:= :age 1) (dsl "\"age\" = 1")))
  (signals sql-error (dsl "nope = 1"))
  (signals sql-error (dsl "other.age = 1"))
  (signals sql-error (dsl "people.nope = 1"))
  (handler-case (dsl "nope = 1")
    (sql-error (c) (is (search "Unknown column nope" (error-message c))))))

(def-test sql-parameters (:fixture clean-db)
  (make-people)
  (is (equal '(:and (:= :age 30) (:like :name "a%")) (dsl "age = ? AND name LIKE ?" 30 "a%")))
  (is (equal '(:= :name "x'; DROP TABLE people; --") (dsl "name = ?" "x'; DROP TABLE people; --"))
      "a value is data, never SQL")
  (is (equal '(:= :age :null) (dsl "age = ?" :null)))
  (is (equal '(:= :name (:quote :red)) (dsl "name = ?" :red)) "a keyword value stays a constant")
  (is (equal '(:= :name (:quote (1 2))) (dsl "name = ?" '(1 2))))
  (is (equal '(:= :active nil) (dsl "active = ?" nil)) "nil is false")
  (signals sql-error (dsl "age = ?"))
  (signals sql-error (dsl "age = ?" 1 2))
  (signals sql-error (dsl "age = 1" 5)))

(def-test sql-things-that-are-not-supported (:fixture clean-db)
  (make-people)
  (signals sql-error (dsl "age % 2 = 0"))
  (signals sql-error (dsl "frobnicate(age) = 1"))
  (signals sql-error (dsl "lower() = 'x'"))
  (signals sql-error (dsl "lower(age, name) = 'x'"))
  (signals sql-error (dsl "sum(*) > 1"))
  (handler-case (dsl "frobnicate(age) = 1")
    (sql-error (c) (is (search "Supported:" (error-message c))))))

;;; end to end: the same rows as the expression written by hand

(defun same-rows-p (sql-text &rest args)
  (let ((by-sql (names-of (select :from "people" :where (apply #'sql-expression sql-text "people" args)
                                  :order-by :id))))
    by-sql))

(def-test sql-expressions-select-the-right-rows (:fixture clean-db)
  (make-sample-people)
  (is (equal '("ann" "cat") (same-rows-p "age = 30")))
  (is (equal '("ann" "cat" "Eve") (same-rows-p "age >= ?" 30)))
  (is (equal '("bob" "Eve") (same-rows-p "NOT age = 30")) "NULL age is not kept")
  (is (equal '("bob" "Eve") (same-rows-p "age <> 30")))
  (is (equal '("dan") (same-rows-p "age IS NULL")))
  (is (equal '("ann" "bob" "cat") (same-rows-p "age BETWEEN 25 AND 30")))
  (is (equal '("Eve") (same-rows-p "age NOT BETWEEN 25 AND 30")))
  (is (equal '("ann" "bob" "cat") (same-rows-p "age IN (25, ?)" 30)))
  (is (equal '("Eve") (same-rows-p "age > 30 OR name = 'zed'")))
  (is (equal '("ann" "cat" "dan") (same-rows-p "age = 30 OR age IS NULL")))
  (is (equal '("ann") (same-rows-p "name LIKE ? AND age = 30" "a%")))
  (is (equal '("bob" "cat" "dan" "Eve") (same-rows-p "name NOT LIKE 'a%'")))
  (is (equal '("ann") (same-rows-p "lower(name) = 'ann' AND upper(name) = 'ANN'")))
  (is (equal '("ann") (same-rows-p "name || '!' = 'ann!'")))
  (is (equal '("Eve") (same-rows-p "age + 1 = 42")))
  (is (equal '("dan") (same-rows-p "coalesce(age, 0) = 0")))
  (is (equal '("ann" "cat" "Eve") (same-rows-p "active")))
  (is (equal '("bob") (same-rows-p "active = false")))
  (is (equal '("ann") (same-rows-p "name = ?" "ann")))
  (is (equal '("ann" "bob" "cat" "dan" "Eve") (same-rows-p "name = name"))))

(def-test sql-injection-attempts-stay-data (:fixture clean-db)
  (make-sample-people)
  (is (equal '() (same-rows-p "name = ?" "ann' OR '1'='1")))
  (is (equal '() (same-rows-p "name = ?" "'; DELETE FROM people; --")))
  (is (= 5 (count-rows "people"))))

(def-test sql-expression-uses-indexes-like-the-hand-written-form (:fixture clean-db)
  (make-sample-people)
  (create-index "people" :age)
  (let ((step (first (explain :from "people" :where (sql-expression "age = 30 AND name LIKE 'a%'" "people")))))
    (is (equal '(:index :eq 2) (list (getf (cddr step) :access) (getf (cddr step) :op) (getf (cddr step) :rows)))))
  (let ((step (first (explain :from "people" :where (sql-expression "age BETWEEN 25 AND ?" "people" 30)))))
    (is (equal '(:index :range) (list (getf (cddr step) :access) (getf (cddr step) :op))))))

(def-test sql-aggregates-are-not-allowed-in-where (:fixture clean-db)
  (make-sample-people)
  (signals query-error (select :from "people" :where (sql-expression "count(*) > 1" "people"))))

(def-test sql-expression-for-views-and-select-results (:fixture clean-db)
  (make-sample-people)
  (create-view "old" :from "people" :where '(>= :age 30))
  (is (equal '("ann") (names-of (select :from "old" :where (sql-expression "name LIKE 'a%'" "old") :order-by :id))))
  (let ((result (select :from "people" :col '(:name :age))))
    (is (equal '("Eve") (names-of (select :from result :where (sql-expression "age > 40" result)))))))
