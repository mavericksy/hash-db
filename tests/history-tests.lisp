(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defun current-seq () (hash-db::db-seq hash-db::*db*))

(def-test history-is-off-by-default (:fixture clean-db)
  (make-people)
  (insert-row '(:name "ann") "people")
  (is (null (history)))
  (signals history-error (with-as-of (:seq 1) (row-list "people"))))

(def-test keep-history-lists-versions-newest-first (:fixture clean-db)
  (make-people)
  (keep-history 10)
  (is (equal (list (current-seq)) (mapcar (lambda (v) (getf v :seq)) (history)))
      "the version now is kept at once")
  (insert-row '(:name "ann") "people")
  (insert-row '(:name "bob") "people")
  (is (equal (list (current-seq) (1- (current-seq)) (- (current-seq) 2))
             (mapcar (lambda (v) (getf v :seq)) (history)))))

(def-test as-of-reads-an-older-version (:fixture clean-db)
  (make-people)
  (keep-history 10)
  (insert-row '(:name "ann" :age 30) "people")
  (let ((v1 (current-seq)))
    (insert-row '(:name "bob" :age 25) "people")
    (let ((v2 (current-seq)))
      (update-row 1 '(:age 31) "people")
      (delete-row 2 "people")
      (let ((v4 (current-seq)))
        (is (equal '("ann") (with-as-of (:seq v1) (names-of "people"))))
        (is (equal '(30) (with-as-of (:seq v1) (mapcar (lambda (r) (getf r :age)) (row-list "people")))))
        (is (equal '("ann" "bob") (with-as-of (:seq v2) (names-of "people"))))
        (is (equal '(31) (mapcar (lambda (r) (getf r :age)) (row-list "people"))) "now")
        (is (equal '("ann") (with-as-of (:seq v4) (names-of "people"))))
        (is (equal '("ann") (names-of "people")))))))

(def-test as-of-works-for-queries-indexes-and-views (:fixture clean-db)
  (make-pet-world)
  (create-index "people" :age)
  (create-view "adults" :from "people" :where '(>= :age 30))
  (keep-history 10)
  (let ((before (current-seq)))
    (update-where "people" '(:age 99) :where t)
    (delete-where "toys" :where t)
    (delete-where "pets" :where t)
    (is (equal '("ann" "cat") (with-as-of (:seq before) (names-of "adults"))))
    (is (equal '("ann" "cat") (with-as-of (:seq before)
                                (names-of (select :from "people" :where '(= :age 30) :order-by :id)))))
    (is (equal :index (with-as-of (:seq before)
                        (getf (hash-db::plan-access (find-table "people") '(= :age 30)) :kind)))
        "the old indexes are there")
    (is (equal '(("ann" "rex") ("ann" "tom") ("bob" :null) ("cat" "kit"))
               (with-as-of (:seq before) (joined :from "people" :left-join '("pets" :id :owner)))))
    (is (equal '(("ann" :null) ("bob" :null) ("cat" :null))
               (joined :from "people" :left-join '("pets" :id :owner))))
    (is (= 4 (with-as-of (:seq before)
               (getf (first (row-list (select :from "pets" :col '((as (count) :n))))) :n))))
    (is (= 0 (getf (first (row-list (select :from "pets" :col '((as (count) :n))))) :n)))))

(def-test as-of-by-time (:fixture clean-db)
  (make-people)
  (keep-history 10)
  (with-clock (1000) (insert-row '(:name "ann") "people"))
  (with-clock (2000) (insert-row '(:name "bob") "people"))
  (with-clock (3000) (insert-row '(:name "cat") "people"))
  (is (equal '("ann") (with-as-of (:time 1000) (names-of "people"))))
  (is (equal '("ann") (with-as-of (:time 1999) (names-of "people"))))
  (is (equal '("ann" "bob") (with-as-of (:time 2000) (names-of "people"))))
  (is (equal '("ann" "bob" "cat") (with-as-of (:time 99999) (names-of "people"))))
  (signals history-error (with-as-of (:time 5) (names-of "people")) "older than any kept version"))

(def-test history-keeps-only-the-limit (:fixture clean-db)
  (make-people)
  (keep-history 3)
  (dotimes (i 6) (insert-row (list :name (format nil "p~D" i)) "people"))
  (let ((seqs (mapcar (lambda (v) (getf v :seq)) (history))))
    (is (= 3 (length seqs)))
    (is (= (current-seq) (first seqs)))
    (signals history-error (with-as-of (:seq (- (current-seq) 5)) (row-list "people")))
    (is (= 4 (with-as-of (:seq (third seqs)) (count-rows "people")))))
  (keep-history 1)
  (is (= 1 (length (history))))
  (keep-history 0)
  (is (null (history)))
  (signals history-error (with-as-of (:seq (current-seq)) nil)))

(def-test history-records-only-commits-that-changed-data (:fixture clean-db)
  (make-people)
  (keep-history 10)
  (let ((n (length (history))))
    (row-list "people")
    (with-transaction (get-row 1 "people"))
    (with-transaction (insert-row '(:name "x") "people") (rollback))
    (ignore-errors (insert-row '(:name "x" :age "bad") "people"))
    (is (= n (length (history))))
    (insert-row '(:name "y") "people")
    (is (= (1+ n) (length (history))))))

(def-test as-of-sees-tables-that-were-created-or-dropped-later (:fixture clean-db)
  (keep-history 10)
  (make-people)
  (let ((with-people (current-seq)))
    (drop-table "people")
    (is (equal '() (show-tables)))
    (is (equal '("people") (with-as-of (:seq with-people) (show-tables))))
    (make-table "later" '((:a number)))
    (is (equal '("people") (with-as-of (:seq with-people) (show-tables))))
    (signals no-such-table (with-as-of (:seq with-people) (find-table "later")))))

(def-test as-of-is-read-only (:fixture clean-db)
  (make-people)
  (keep-history 10)
  (insert-row '(:name "ann") "people")
  (let ((v (current-seq)))
    (signals transaction-error (with-as-of (:seq v) (insert-row '(:name "x") "people")))
    (signals transaction-error (with-as-of (:seq v) (with-transaction (update-row 1 '(:age 1) "people"))))
    (signals transaction-error (with-as-of (:seq v) (make-table "t" '((:a number)))))
    (signals transaction-error (with-as-of (:seq v) (next-value (progn (create-sequence "s") "s"))))
    (is (equal '("ann") (names-of "people")) "nothing changed")
    (signals transaction-error (with-transaction (with-as-of (:seq v) nil))
             "as-of can't start inside a transaction")))

(def-test as-of-argument-errors (:fixture clean-db)
  (make-people)
  (keep-history 5)
  (signals history-error (with-as-of ()))
  (signals history-error (with-as-of (:seq 1 :time 5)))
  (signals history-error (keep-history -1))
  (signals history-error (keep-history 1.5))
  (signals history-error (with-as-of (:seq 9999) nil)))

(def-test as-of-returns-the-values-of-its-body (:fixture clean-db)
  (make-people)
  (keep-history 5)
  (is (equal '(1 2) (multiple-value-list (with-as-of (:seq (current-seq)) (values 1 2))))))

(def-test a-reader-keeps-its-version-while-writers-commit (:fixture clean-db)
  (make-people)
  (keep-history 50)
  (insert-row '(:name "first") "people")
  (let* ((v (current-seq))
         (counts '())
         (reader (bt:make-thread
                   (lambda ()
                     (with-as-of (:seq v)
                       (dotimes (i 200)
                         (push (count-rows "people") counts)
                         (sleep 0.001)))))))
    (dotimes (i 30) (insert-row (list :name (format nil "p~D" i)) "people"))
    (bt:join-thread reader)
    (is (equal '(1) (remove-duplicates counts)))
    (is (= 31 (count-rows "people")))))

(def-test history-is-not-kept-across-a-restart (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (make-people)
      (keep-history 10)
      (insert-row '(:name "ann") "people")
      (restart-db path)
      (is (null (history)))
      (is (= 1 (count-rows "people"))))))
