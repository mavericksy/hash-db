(in-package #:hash-db-tests)

(in-suite hash-db-suite)

;;; reading and writing

(def-test json-reads-scalars (:fixture clean-db)
  (is (eq :true (json-decode "true")))
  (is (eq :false (json-decode " false ")))
  (is (eq :null (json-decode "null")))
  (is (equal "hi" (json-decode "\"hi\"")))
  (is (= 0 (json-decode "0")))
  (is (= -12 (json-decode "-12")))
  (is (= 123456789012345678901234567890 (json-decode "123456789012345678901234567890")))
  (is (eql 1.5d0 (json-decode "1.5")))
  (is (eql -0.25d0 (json-decode "-0.25")))
  (is (eql 1000.0d0 (json-decode "1e3")))
  (is (eql 1000.0d0 (json-decode "1E+3")))
  (is (eql 0.0015d0 (json-decode "1.5e-3")))
  (is (eql 10.0d0 (json-decode "10.0"))))

(def-test json-reads-containers (:fixture clean-db)
  (is (equalp #() (json-decode "[]")))
  (is (equal '(:object) (json-decode " { } ")))
  (is (equalp #(1 "a" :null) (json-decode "[1, \"a\", null]")))
  (is (equalp '(:object ("a" . 1) ("b" . #(2 3)) ("c" . (:object ("d" . :true))))
              (json-decode "{\"a\": 1, \"b\": [2, 3], \"c\": {\"d\": true}}"))))

(def-test json-reads-escapes (:fixture clean-db)
  (is (equal (concatenate 'string "a" (string #\Newline) "b" (string #\Tab) "c\\d")
             (json-decode "\"a\\nb\\tc\\\\d\"")))
  (is (equal "\"/" (json-decode "\"\\\"\\/\"")))
  (is (equal "é" (json-decode "\"\\u00e9\"")))
  (is (equal (string (code-char #x1F600)) (json-decode "\"\\ud83d\\ude00\"")) "a surrogate pair")
  (is (equal "日本" (json-decode "\"日本\"")))
  (is (equal (string (code-char 1)) (json-decode "\"\\u0001\""))))

(def-test json-rejects-bad-text (:fixture clean-db)
  (dolist (text '("" " " "tru" "nul" "True" "[1,]" "[,1]" "{\"a\":1,}" "{a:1}" "{\"a\" 1}" "[1 2]"
                  "{\"a\":1 \"b\":2}" "01" "-" "1." ".5" "1e" "1e+" "+1" "--1" "0x10" "NaN" "Infinity"
                  "\"abc" "\"a\\x\"" "\"\\u12\"" "\"\\u12zz\"" "\"\\ud83d\"" "\"\\ude00\"" "\"\\ud83dx\""
                  "[1]]" "[1] 2" "{}x" "'a'" "[" "{" "{\"a\"" "{\"a\":" "1e999"
                  #.(format nil "\"tab~Cinside\"" #\Tab)))
    (signals json-error (json-decode text) "~S" text))
  (signals json-error (json-decode 5))
  (signals json-error (json-decode (concatenate 'string (make-string 600 :initial-element #\[))))
  (finishes (json-decode (concatenate 'string (make-string 400 :initial-element #\[)
                                      (make-string 400 :initial-element #\])))))

(def-test json-writes-compact-text (:fixture clean-db)
  (is (equal "null" (json-encode :null)))
  (is (equal "true" (json-encode :true)))
  (is (equal "false" (json-encode :false)))
  (is (equal "true" (json-encode t)))
  (is (equal "false" (json-encode nil)))
  (is (equal "12" (json-encode 12)))
  (is (equal "1.5" (json-encode 1.5d0)))
  (is (equal "0.5" (json-encode 1/2)))
  (is (equal "\"a\\\"b\\\\c\\nd\\u0001\"" (json-encode (format nil "a\"b\\c~Cd~C" #\Newline (code-char 1)))))
  (is (equal "[1,\"a\",null]" (json-encode (vector 1 "a" :null))))
  (is (equal "{\"a\":1,\"b\":[2]}" (json-encode '(:object ("a" . 1) ("b" . #(2))))))
  (is (equal "{}" (json-encode '(:object))))
  (is (equal "[]" (json-encode #())))
  (is (equal "\"é日本\"" (json-encode "é日本"))))

(def-test json-write-errors (:fixture clean-db)
  (signals json-error (json-encode :unknown))
  (signals json-error (json-encode '(1 2)))
  (signals json-error (json-encode '(:object (1 . 2))))
  (signals json-error (json-encode sb-ext:double-float-positive-infinity)))

(def-test json-round-trips-random-data (:fixture clean-db)
  (let ((rs (sb-ext:seed-random-state 99)))
    (labels ((random-data (depth)
               (case (random (if (> depth 3) 5 7) rs)
                 (0 :null) (1 (if (zerop (random 2 rs)) :true :false))
                 (2 (- (random 2000000 rs) 1000000))
                 (3 (* (- (random 2000 rs) 1000) (expt 10d0 (- (random 10 rs) 5))))
                 (4 (let ((n (random 8 rs)))
                      (coerce (loop repeat n
                                    collect (nth (random 9 rs)
                                                 (list #\a #\Z #\" #\\ #\Newline #\Tab #\é (code-char #x1F600)
                                                       (code-char 7))))
                              'string)))
                 (5 (coerce (loop repeat (random 4 rs) collect (random-data (1+ depth))) 'simple-vector))
                 (t (cons :object (loop repeat (random 4 rs)
                                        collect (cons (format nil "k~D" (random 5 rs))
                                                      (random-data (1+ depth)))))))))
      (dotimes (i 300)
        (let* ((data (random-data 0))
               (text (json-encode data)))
          (is (equalp data (json-decode text)) "round trip of ~A" text)
          (is (equal text (json-encode (json-decode text))) "the text is stable"))))))

;;; the column type

(defun make-docs ()
  (make-table "docs" '((:id primary-key-column) (:body json))))

(defun body-ids (where)
  (mapcar (lambda (r) (getf r :id)) (row-list (select :from "docs" :where where))))

(def-test json-column-checks-and-compacts (:fixture clean-db)
  (make-docs)
  (insert-row '(:body "{ \"a\" : [ 1 , 2 ] }") "docs")
  (is (equal "{\"a\":[1,2]}" (getf (get-row 1 "docs") :body)))
  (signals type-mismatch (insert-row '(:body "{not json}") "docs"))
  (signals type-mismatch (insert-row '(:body 5) "docs"))
  (finishes (insert-row '() "docs") "NULL is fine")
  (signals type-mismatch (update-row 1 '(:body "[1,") "docs"))
  (is (= 2 (count-rows "docs"))))

(def-test json-column-default-is-checked (:fixture clean-db)
  (signals type-mismatch (make-table "t" '((:b json :default "oops"))))
  (make-table "t" '((:id primary-key-column) (:b json :default "{ }")))
  (insert-row '() "t")
  (is (equal "{}" (getf (get-row 1 "t") :b))))

(def-test equal-documents-are-equal-values (:fixture clean-db)
  (make-table "u" '((:id primary-key-column) (:b json :unique t)))
  (insert-row '(:b "{\"a\": 1}") "u")
  (signals unique-violation (insert-row '(:b "{ \"a\" :1 }") "u"))
  (is (= 1 (count-rows (select :from "u" :where '(= :b "{\"a\":1}"))))
      "a constant that is already compact matches"))

;;; json-get

(defun make-people-docs ()
  (make-docs)
  (dolist (body '("{\"name\":\"ann\",\"age\":30,\"tags\":[\"x\",\"y\"],\"addr\":{\"city\":\"oslo\"},\"ok\":true,\"no\":false,\"nil\":null,\"pi\":3.5}"
                  "{\"name\":\"bob\",\"age\":25,\"tags\":[],\"addr\":{\"city\":\"rome\"}}"
                  "[1,2,3]"
                  "\"just a string\""))
    (insert-row (list :body body) "docs"))
  (insert-row '() "docs"))

(defun get-all (&rest path)
  (mapcar (lambda (r) (getf r :v))
          (row-list (select :from "docs" :col `((as (json-get :body ,@path) :v)) :order-by :id))))

(def-test json-get-reads-values (:fixture clean-db)
  (make-people-docs)
  (is (equal '("ann" "bob" :null :null :null) (get-all "name")))
  (is (equal '(30 25 :null :null :null) (get-all "age")))
  (is (equal '("oslo" "rome" :null :null :null) (get-all "addr" "city")))
  (is (equal '("x" :null :null :null :null) (get-all "tags" 0)))
  (is (equal '("y" :null :null :null :null) (get-all "tags" 1)))
  (is (equal '(:null :null 1 :null :null) (get-all 0)))
  (is (equal '(:null :null 3 :null :null) (get-all 2)))
  (is (equal '(t :null :null :null :null) (get-all "ok")))
  (is (equal '(nil :null :null :null :null) (get-all "no")))
  (is (equal '(:null :null :null :null :null) (get-all "nil")))
  (is (equal '(3.5d0 :null :null :null :null) (get-all "pi"))))

(def-test json-get-gives-text-for-containers (:fixture clean-db)
  (make-people-docs)
  (is (equal '("[\"x\",\"y\"]" "[]" :null :null :null) (get-all "tags")))
  (is (equal '("{\"city\":\"oslo\"}" "{\"city\":\"rome\"}" :null :null :null) (get-all "addr")))
  (is (equal "[1,2,3]" (third (get-all))) "no path gives the whole document")
  (is (equal "just a string" (fourth (get-all))) "a string comes out as a plain string")
  (is (eq :null (fifth (get-all)))))

(def-test json-get-misses-give-null (:fixture clean-db)
  (make-people-docs)
  (is (equal '(:null :null :null :null :null) (get-all "nothing")))
  (is (equal '(:null :null :null :null :null) (get-all "tags" 5)))
  (is (equal '(:null :null :null :null :null) (get-all "tags" -1)))
  (is (equal '(:null :null :null :null :null) (get-all "name" "deeper")))
  (is (equal '(:null :null :null :null :null) (get-all "name" 0))))

(def-test json-get-in-where-sort-and-group (:fixture clean-db)
  (make-people-docs)
  (is (equal '(1) (body-ids '(= (json-get :body "name") "ann"))))
  (is (equal '(1) (body-ids '(> (json-get :body "age") 26))))
  (is (equal '(1 2) (sort (body-ids '(like (json-get :body "addr" "city") "%o%")) #'<)))
  (is (equal '(2 1) (mapcar (lambda (r) (getf r :id))
                            (row-list (select :from "docs" :where '(is-not-null (json-get :body "age"))
                                                :order-by '((asc (json-get :body "age"))))))))
  (is (equal '((:city "oslo" :n 1) (:city "rome" :n 1))
             (row-list (select :from "docs" :where '(is-not-null (json-get :body "addr" "city"))
                               :group-by '((json-get :body "addr" "city"))
                               :col '((as (json-get :body "addr" "city") :city) (as (count) :n))
                               :order-by :city)))))

(def-test json-get-errors (:fixture clean-db)
  (make-docs)
  (make-table "plain" '((:id primary-key-column) (:s string)))
  (insert-row '(:s "not json") "plain")
  (signals query-error (select :from "plain" :where '(= (json-get :s "a") 1)))
  (signals query-error (select :from "docs" :where '(= (json-get) 1)))
  (is (= 0 (count-rows (select :from "docs" :where '(= (json-get :body "a") 1)))) "an empty table is fine"))

(def-test json-column-survives-snapshot-log-and-index (:fixture clean-db)
  (make-people-docs)
  (create-index "docs" :body)
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (load-db path)))
  (is (equal '(1) (body-ids '(= (json-get :body "name") "ann"))))
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (clear-db)
      (open-db path)
      (make-docs)
      (insert-row (list :body "{ \"é\" : \"日本\\n\" }") "docs")
      (restart-db path)
      (is (equal "{\"é\":\"日本\\n\"}" (getf (get-row 1 "docs") :body))))))
