(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defun make-alter-world ()
  (make-table "people" '((:id primary-key-column) (:name string :unique t) (:age integer)
                         (:seen timestamp)))
  (create-index "people" :age)
  (make-table "pets" (list '(:pet-id primary-key-column)
                           (list :owner 'foreign-key-column :references "people" :on-delete :cascade)
                           '(:pet string)))
  (insert-row '(:name "ann" :age 30 :seen 100) "people")
  (insert-row '(:name "bob" :age 25 :seen 900) "people")
  (insert-row '(:owner 1 :pet "rex") "pets")
  (insert-row '(:owner 2 :pet "tom") "pets"))

;;; rename-column

(def-test rename-column-moves-rows-and-indexes (:fixture clean-db)
  (make-alter-world)
  (is (eq :years (rename-column "people" :age :years)))
  (is (equal '(:id :name :years :seen) (mapcar #'name (schema (find-table "people")))))
  (is (equal '((:id 1 :name "ann" :years 30 :seen 100) (:id 2 :name "bob" :years 25 :seen 900))
             (row-list "people")))
  (is (equal '("bob") (mapcar (lambda (r) (getf r :name))
                              (row-list (select :from "people" :where '(= :years 25))))))
  (is (equal :index (getf (hash-db::plan-access (find-table "people") '(= :years 25)) :kind))
      "the explicit index follows the column")
  (signals no-such-column (select :from "people" :where '(= :age 25)))
  (is (indexes-match-rows-p)))

(def-test rename-column-keeps-its-rules (:fixture clean-db)
  (make-alter-world)
  (rename-column "people" :name :label)
  (signals unique-violation (insert-row '(:label "ann") "people"))
  (is (equal '(:label-unique :age-index) (index-names "people")) "the implicit index took the new name")
  (rename-column "people" "Seen" "expires")
  (set-ttl "people" :expires)
  (rename-column "people" :expires :until)
  (is (eq :until (ttl-column "people")))
  (with-clock (500) (is (= 1 (purge-expired))))
  (is (equal '("bob") (mapcar (lambda (r) (getf r :label)) (row-list "people")))))

(def-test rename-column-renames-the-name-in-a-check-expression (:fixture clean-db)
  (make-table "t" '((:id primary-key-column)
                    (:n integer :check (and (> :n 0) (< :n 10) (/= :n (quote :n))))
                    (:m integer :check (> :m 0))))
  (rename-column "t" :n :count)
  (signals check-violation (insert-row '(:count 0) "t"))
  (signals check-violation (insert-row '(:count 10) "t"))
  (signals check-violation (insert-row '(:m 0) "t"))
  (finishes (insert-row '(:count 5 :m 1) "t"))
  (rename-column "t" :count :total)
  (signals check-violation (insert-row '(:total -1) "t"))
  (is (= 1 (count-rows "t"))))

(def-test rename-column-can-rename-the-primary-key (:fixture clean-db)
  (make-alter-world)
  (rename-column "people" :id :uid)
  (is (equal 1 (getf (get-row 1 "people") :uid)))
  (is (= 3 (insert-row '(:name "cat") "people")))
  (is (= 3 (getf (get-row 3 "people") :uid))))

(def-test rename-column-errors (:fixture clean-db)
  (make-alter-world)
  (signals no-such-column (rename-column "people" :nope :x))
  (signals schema-error (rename-column "people" :age :name))
  (signals no-such-table (rename-column "nope" :a :b))
  (signals schema-error (rename-column (progn (create-view "v" :from "people") "v") :id :x)))

;;; drop-column

(def-test drop-column-removes-data-and-indexes (:fixture clean-db)
  (make-alter-world)
  (is-true (drop-column "people" :age))
  (is (equal '(:id :name :seen) (mapcar #'name (schema (find-table "people")))))
  (is (equal '((:id 1 :name "ann" :seen 100) (:id 2 :name "bob" :seen 900)) (row-list "people")))
  (is (equal '(:name-unique) (index-names "people")) "the index on age went with it")
  (drop-column "people" :name)
  (is (null (index-names "people")))
  (finishes (insert-row '(:seen 5) "people"))
  (is (indexes-match-rows-p)))

(def-test drop-column-clears-a-ttl-on-it (:fixture clean-db)
  (make-alter-world)
  (set-ttl "people" :seen)
  (drop-column "people" :seen)
  (is (null (ttl-column "people"))))

(def-test drop-column-errors (:fixture clean-db)
  (make-alter-world)
  (signals schema-error (drop-column "people" :id))
  (signals no-such-column (drop-column "people" :nope))
  (make-table "one" '((:a number)))
  (signals schema-error (drop-column "one" :a))
  (is (equal '(:id :name :age :seen) (mapcar #'name (schema (find-table "people"))))))

(def-test drop-foreign-key-column (:fixture clean-db)
  (make-alter-world)
  (drop-column "pets" :owner)
  (is (null (index-names "pets")))
  (delete-row 1 "people")
  (is (= 2 (count-rows "pets")) "pets no longer refer to people"))

;;; rename-table

(def-test rename-table-keeps-everything (:fixture clean-db)
  (make-alter-world)
  (create-trigger :audit "people" :after :insert 'note-call)
  (is (equal "humans" (rename-table "people" "humans")))
  (is (equal '("humans" "pets") (sort (show-tables) #'string<)))
  (signals no-such-table (find-table "people"))
  (is (= 2 (count-rows "humans")))
  (is (equal '(:name-unique :age-index) (index-names "humans")))
  (is (equal '(:audit) (mapcar (lambda (tr) (getf tr :name)) (show-triggers "humans"))))
  (is (indexes-match-rows-p)))

(def-test rename-table-moves-foreign-keys-that-refer-to-it (:fixture clean-db)
  (make-alter-world)
  (rename-table "people" "humans")
  (finishes (insert-row '(:owner 1 :pet "kit") "pets"))
  (signals foreign-key-violation (insert-row '(:owner 99 :pet "x") "pets"))
  (delete-row 1 "humans")
  (is (equal '("tom") (mapcar (lambda (r) (getf r :pet)) (row-list "pets"))) "the cascade still works")
  (is (equal "humans" (hash-db::references (find :owner (schema (find-table "pets")) :key #'name)))))

(def-test rename-table-with-a-self-reference (:fixture clean-db)
  (make-table "nodes" (list '(:id primary-key-column)
                            (list :parent 'foreign-key-column :references "nodes" :on-delete :cascade)))
  (insert-row '() "nodes")
  (insert-row '(:parent 1) "nodes")
  (rename-table "nodes" "tree")
  (finishes (insert-row '(:parent 2) "tree"))
  (signals foreign-key-violation (insert-row '(:parent 77) "tree"))
  (delete-row 1 "tree")
  (is (= 0 (count-rows "tree"))))

(def-test rename-table-errors (:fixture clean-db)
  (make-alter-world)
  (signals no-such-table (rename-table "nope" "x"))
  (signals schema-error (rename-table "people" "pets"))
  (create-sequence "seq")
  (signals schema-error (rename-table "people" "seq"))
  (is (equal '("people" "pets") (sort (show-tables) #'string<))))

(def-test views-do-not-follow-a-renamed-table (:fixture clean-db)
  (make-alter-world)
  (create-view "v" :from "people")
  (rename-table "people" "humans")
  (signals no-such-table (select :from "v")))

;;; the log

(def-test alter-changes-roll-back (:fixture clean-db)
  (make-alter-world)
  (with-transaction
    (rename-column "people" :age :years)
    (drop-column "people" :seen)
    (rename-table "people" "humans")
    (rollback))
  (is (equal '("people" "pets") (sort (show-tables) #'string<)))
  (is (equal '(:id :name :age :seen) (mapcar #'name (schema (find-table "people"))))))

(def-test alter-changes-survive-log-snapshot-and-checkpoint (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (make-alter-world)
      (rename-column "people" :age :years)
      (drop-column "people" :seen)
      (rename-table "people" "humans")
      (let ((before (table-states (hash-db::db-root hash-db::*db*))))
        (restart-db path)
        (is (equal before (table-states (hash-db::db-root hash-db::*db*))) "from the log")
        (is (indexes-match-rows-p))
        (checkpoint)
        (restart-db path)
        (is (equal before (table-states (hash-db::db-root hash-db::*db*))) "from the snapshot"))
      (finishes (insert-row '(:owner 1 :pet "kit") "pets")))))

(def-test replaying-alters-rebuilds-the-same-database (:fixture clean-db)
  (let ((records '()))
    (let ((hash-db::*commit-hook* (lambda (seq entries) (push (cons seq entries) records))))
      (make-alter-world)
      (create-trigger :audit "people" :after :insert 'note-call)
      (set-ttl "people" :seen)
      (rename-column "people" :seen :until)
      (rename-table "people" "humans")
      (rename-column "humans" :name :label)
      (drop-column "humans" :age)
      (insert-row '(:label "cat" :until 5) "humans")
      (rename-table "pets" "animals"))
    (let ((root (fset:empty-map)))
      (dolist (record (reverse records))
        (setf root (hash-db::replay-entries root (cdr record))))
      (is (equal (table-states (hash-db::db-root hash-db::*db*)) (table-states root)))
      (is (indexes-match-rows-p root))
      (is (equal (mapcar (lambda (tbl) (list (name tbl) (hash-db::ttl tbl)
                                             (mapcar #'hash-db::index-name (hash-db::indexes tbl))
                                             (mapcar #'hash-db::trigger-name (hash-db::triggers tbl))))
                         (hash-db::all-tables (hash-db::db-root hash-db::*db*)))
                 (mapcar (lambda (tbl) (list (name tbl) (hash-db::ttl tbl)
                                             (mapcar #'hash-db::index-name (hash-db::indexes tbl))
                                             (mapcar #'hash-db::trigger-name (hash-db::triggers tbl))))
                         (hash-db::all-tables root)))))))

;;; migrations

(def-test migration-runs-once (:fixture clean-db)
  (let ((runs 0))
    (is (eq :applied (migrate "001-people" (lambda () (incf runs) (make-people)))))
    (is (eq :skipped (migrate "001-people" (lambda () (incf runs) (error "no")))))
    (is (= 1 runs))
    (is (equal '("001-people") (applied-migrations)))
    (is (member "_migrations" (show-tables) :test #'equal))))

(def-test migrations-run-in-order-and-use-alter-calls (:fixture clean-db)
  (let ((list (list (list "001" (lambda () (make-people)))
                    (list "002" (lambda () (add-column "people" '(:email string :default "none"))))
                    (list :003 (lambda () (rename-column "people" :email :mail))))))
    (is (equal '("001" "002" "003") (migrate-all list)))
    (is (equal '() (migrate-all list)) "a second run does nothing")
    (is (equal '("001" "002" "003") (applied-migrations)))
    (is (equal '(:id :name :age :active :mail) (mapcar #'name (schema (find-table "people")))))
    (let ((more (append list (list (list "004" (lambda () (drop-column "people" :mail)))))))
      (is (equal '("004") (migrate-all more)))
      (is (equal '(:id :name :age :active) (mapcar #'name (schema (find-table "people"))))))))

(def-test failed-migration-leaves-nothing (:fixture clean-db)
  (migrate "001" (lambda () (make-people)))
  (signals simple-error
    (migrate "002" (lambda ()
                     (add-column "people" '(:x number))
                     (insert-row '(:name "half") "people")
                     (error "boom"))))
  (is (equal '("001") (applied-migrations)))
  (is (equal '(:id :name :age :active) (mapcar #'name (schema (find-table "people")))))
  (is (= 0 (count-rows "people")))
  (is (eq :applied (migrate "002" (lambda () (add-column "people" '(:x number)))))
      "it can run again once fixed"))

(def-test first-migration-failing-leaves-no-migrations-table (:fixture clean-db)
  (signals simple-error (migrate "001" (lambda () (error "boom"))))
  (is (null (show-tables)))
  (is (null (applied-migrations))))

(def-test migrations-are-remembered-across-restarts (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir))
          (runs 0))
      (open-db path)
      (migrate "001" (lambda () (incf runs) (make-people)))
      (restart-db path)
      (is (eq :skipped (migrate "001" (lambda () (incf runs)))))
      (is (eq :applied (migrate "002" (lambda () (incf runs) (add-column "people" '(:x number))))))
      (checkpoint)
      (restart-db path)
      (is (equal '("001" "002") (applied-migrations)))
      (is (= 2 runs)))))
