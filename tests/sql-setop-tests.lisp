(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defun make-two-lists ()
  "Tables a and b with a column x. a holds 1 2 2 3 NULL and b holds 2 3 3 4 NULL."
  (sql-script "CREATE TABLE a (id INTEGER PRIMARY KEY, x INTEGER, label TEXT);
               CREATE TABLE b (id INTEGER PRIMARY KEY, y INTEGER);
               INSERT INTO a (x, label) VALUES (1, 'a1'), (2, 'a2'), (2, 'a2b'), (3, 'a3'), (NULL, 'an');
               INSERT INTO b (y) VALUES (2), (3), (3), (4), (NULL)"))

(defun column-values (rows key)
  (mapcar (lambda (r) (getf r key)) rows))

(def-test sql-union (:fixture clean-db)
  (make-two-lists)
  (is (equal '(1 2 3 :null 4)
             (column-values (sq "SELECT x FROM a UNION SELECT y FROM b") :x))
      "duplicates go, NULL equals NULL, the first table names the column")
  (is (equal '(1 2 2 3 :null 2 3 3 4 :null)
             (column-values (sq "SELECT x FROM a UNION ALL SELECT y FROM b") :x)))
  (is (equal '(1 2 3 :null 4)
             (column-values (sq "SELECT x FROM a UNION DISTINCT SELECT y FROM b") :x))))

(def-test sql-intersect-and-except (:fixture clean-db)
  (make-two-lists)
  (is (equal '(2 3 :null) (column-values (sq "SELECT x FROM a INTERSECT SELECT y FROM b") :x)))
  (is (equal '(1) (column-values (sq "SELECT x FROM a EXCEPT SELECT y FROM b") :x)))
  (is (equal '(4) (column-values (sq "SELECT y FROM b EXCEPT SELECT x FROM a") :y)))
  (is (equal '(1 2 3 :null) (column-values (sq "SELECT x FROM a EXCEPT SELECT y FROM b WHERE y = 99") :x))
      "except nothing is a distinct list"))

(def-test sql-three-queries-and-precedence (:fixture clean-db)
  (make-two-lists)
  (sql "CREATE TABLE c (id INTEGER PRIMARY KEY, z INTEGER)")
  (sql "INSERT INTO c (z) VALUES (3), (4), (5)")
  (is (equal '(1 2 3 :null 4 5)
             (column-values (sq "SELECT x FROM a UNION SELECT y FROM b UNION SELECT z FROM c") :x)))
  ;; A UNION (B INTERSECT C): b and c share 3 and 4, so the answer is a's values and 3, 4
  (is (equal '(1 2 3 :null 4)
             (column-values (sq "SELECT x FROM a UNION SELECT y FROM b INTERSECT SELECT z FROM c") :x)))
  ;; (A UNION B) INTERSECT C would be 3 4
  (is (equal '(3 4)
             (column-values (sq "(SELECT x FROM a UNION SELECT y FROM b) INTERSECT SELECT z FROM c") :x)))
  (is (equal '(1 2 :null)
             (column-values (sq "SELECT x FROM a EXCEPT SELECT z FROM c EXCEPT SELECT y FROM b WHERE y = 3") :x))
      "left to right: (a except c) except 3"))

(def-test sql-set-operations-with-order-limit-offset (:fixture clean-db)
  (make-two-lists)
  (is (equal '(4 3 2 1 :null)
             (column-values (sq "SELECT x FROM a UNION SELECT y FROM b ORDER BY x DESC") :x))
      "NULL is last")
  (is (equal '(2 3)
             (column-values (sq "SELECT x FROM a UNION SELECT y FROM b ORDER BY x LIMIT 2 OFFSET 1") :x)))
  (is (equal '(3 3 2)
             (column-values (sq "SELECT x FROM a UNION ALL SELECT y FROM b ORDER BY x DESC NULLS FIRST LIMIT 3 OFFSET 4") :x))
      "NULL NULL 4 3 3 3 2 2 2 1: skip four, take three")
  (is (equal '((:v 1) (:v 2))
             (sq "SELECT x AS v FROM a WHERE x IS NOT NULL UNION SELECT y FROM b WHERE y IS NOT NULL ORDER BY v LIMIT 2"))
      "ORDER BY can use the name the first query gives")
  (is (equal '(4 3)
             (column-values (sq "SELECT x FROM a UNION SELECT y FROM b ORDER BY x * -1 LIMIT 2") :x))
      "or an expression about it, but then the NULL row has no key"))

(def-test sql-bracketed-queries-keep-their-own-order-and-limit (:fixture clean-db)
  (make-two-lists)
  (is (equal '(3 2 4 3)
             (column-values (sq "(SELECT x FROM a WHERE x IS NOT NULL ORDER BY x DESC LIMIT 2)
                                 UNION ALL
                                 (SELECT y FROM b WHERE y IS NOT NULL ORDER BY y DESC LIMIT 2)") :x))))

(def-test sql-set-operations-over-more-columns (:fixture clean-db)
  (make-two-lists)
  (is (equal '((:x 2 :label "a2") (:x 2 :label "a2b") (:x 9 :label "nine"))
             (sq "SELECT x, label FROM a WHERE x = 2 UNION SELECT 9, 'nine' FROM b WHERE id = 1 ORDER BY x, label")))
  (is (equal '((:x 2 :label "a2"))
             (sq "SELECT x, label FROM a WHERE x = 2 AND id = 2 INTERSECT SELECT x, label FROM a WHERE x = 2")))
  (is (equal '((:x 2 :label "a2b"))
             (sq "SELECT x, label FROM a WHERE x = 2 EXCEPT SELECT x, label FROM a WHERE label = 'a2'"))
      "a row is equal to another when all its values are"))

(def-test sql-set-operations-in-other-places (:fixture clean-db)
  (make-two-lists)
  (is (equal '(2 2 3)
             (column-values (sq "SELECT x FROM a WHERE x IN (SELECT y FROM b UNION SELECT 3 FROM b) ORDER BY x") :x))
      "in a subquery. The NULL in the answer makes the others unknown")
  (is (equal '((:n 4))
             (sq "SELECT count(*) AS n FROM (SELECT x FROM a UNION SELECT y FROM b) u WHERE x IS NOT NULL"))
      "as a table")
  (sql "CREATE TABLE both (id INTEGER PRIMARY KEY, v INTEGER)")
  (is (= 5 (sql "INSERT INTO both (v) SELECT x FROM a UNION SELECT y FROM b")))
  (is (equal '(1 2 3 :null 4) (column-values (row-list "both") :v))))

(def-test sql-set-operation-parameters-keep-text-order (:fixture clean-db)
  (make-two-lists)
  (is (equal '(1 2 3 4)
             (column-values (sq "SELECT x FROM a WHERE x < ? UNION SELECT y FROM b WHERE y > ? ORDER BY x LIMIT ?" 3 2 10) :x)))
  (is (equal '(3 4)
             (column-values (sq "SELECT x FROM a WHERE x > ? UNION SELECT y FROM b WHERE y > ? ORDER BY x" 2 3) :x))))

(def-test sql-set-operation-types (:fixture clean-db)
  (sql-script "CREATE TABLE n (id INTEGER PRIMARY KEY, v NUMERIC);
               CREATE TABLE m (id INTEGER PRIMARY KEY, w REAL);
               INSERT INTO n (v) VALUES (1), (2.5);
               INSERT INTO m (w) VALUES (1.0), (2.5), (3)")
  (is (equal '(1 2.5d0 3.0d0) (column-values (sq "SELECT v FROM n UNION SELECT w FROM m ORDER BY v") :v))
      "1 and 1.0 are the same value")
  (is (equal '(1) (column-values (sq "SELECT v FROM n WHERE v < 2 INTERSECT SELECT w FROM m") :v)))
  (sql-script "CREATE TABLE s1 (id INTEGER PRIMARY KEY, t TEXT); CREATE TABLE s2 (id INTEGER PRIMARY KEY, t TEXT);
               INSERT INTO s1 (t) VALUES ('a'), ('A'); INSERT INTO s2 (t) VALUES ('a'), ('b')")
  (is (equal '("a" "A" "b") (column-values (sq "SELECT t FROM s1 UNION SELECT t FROM s2") :t)) "case matters"))

(def-test sql-set-operation-errors (:fixture clean-db)
  (make-two-lists)
  (flet ((fails (text)
           (handler-case (progn (sql text) nil)
             (sql-error (c) (error-message c)))))
    (is (search "same number of columns, and these give 1 and 2" (fails "SELECT x FROM a UNION SELECT y, id FROM b")))
    (is (search "same number of columns" (fails "SELECT x FROM a INTERSECT SELECT y, id FROM b")))
    (is (search "INTERSECT ALL is not supported" (fails "SELECT x FROM a INTERSECT ALL SELECT y FROM b")))
    (is (search "EXCEPT ALL is not supported" (fails "SELECT x FROM a EXCEPT ALL SELECT y FROM b")))
    (is (search "Unexpected text" (fails "SELECT x FROM a ORDER BY x UNION SELECT y FROM b")))
    (is (search "column number" (fails "SELECT x FROM a UNION SELECT y FROM b ORDER BY 1")))
    (is (search "Unknown column" (fails "SELECT x FROM a UNION SELECT y FROM b ORDER BY nope")))
    (is (search "one SELECT" (fails "EXPLAIN SELECT x FROM a UNION SELECT y FROM b")))
    (is (search "can't be a UNION" (fails "CREATE VIEW v AS SELECT x FROM a UNION SELECT y FROM b")))
    (is (search "Expected SELECT" (fails "SELECT x FROM a UNION")))
    (signals no-such-table (sql "SELECT x FROM a UNION SELECT y FROM nope"))))

(def-test sql-union-of-many-rows (:fixture clean-db)
  (sql-script "CREATE TABLE big1 (id INTEGER PRIMARY KEY, v INTEGER); CREATE TABLE big2 (id INTEGER PRIMARY KEY, v INTEGER)")
  (with-transaction
    (dotimes (i 5000) (insert-row (list :v i) "big1"))
    (dotimes (i 5000) (insert-row (list :v (+ i 2500)) "big2")))
  (is (= 7500 (length (sq "SELECT v FROM big1 UNION SELECT v FROM big2"))))
  (is (= 10000 (length (sq "SELECT v FROM big1 UNION ALL SELECT v FROM big2"))))
  (is (= 2500 (length (sq "SELECT v FROM big1 INTERSECT SELECT v FROM big2"))))
  (is (= 2500 (length (sq "SELECT v FROM big1 EXCEPT SELECT v FROM big2")))))
