(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defvar *calls* nil)

(defun note-call (event table old new)
  (push (list event table old new) *calls*)
  nil)

(defun make-audit ()
  (make-table "audit" '((:id primary-key-column) (:what string) (:tbl string))))

(defun audit-trigger (event table old new)
  (declare (ignore old new))
  (insert-row (list :what (string-downcase (string event)) :tbl table) "audit")
  nil)

(defun audit-whats ()
  (mapcar (lambda (r) (getf r :what)) (row-list "audit")))

(defun upcase-name (event table old new)
  (declare (ignore event table old))
  (list :name (string-upcase (getf new :name))))

(defun veto (event table old new)
  (declare (ignore event table old new))
  (error "not allowed"))

(defun touch-age (event table old new)
  (declare (ignore event table old))
  (list :age (1+ (let ((age (getf new :age))) (if (eq age :null) 0 age)))))

(defun insert-into-own-table (event table old new)
  (declare (ignore event table old new))
  (insert-row '(:name "own") "people")
  nil)

(defun insert-into-looped (event table old new)
  (declare (ignore event table old new))
  (insert-row '(:name "again") "looped")
  nil)

;;; arguments and events

(def-test trigger-gets-event-table-and-rows (:fixture clean-db)
  (setf *calls* nil)
  (make-people)
  (create-trigger :log "people" :after '(:insert :update :delete) 'note-call)
  (insert-row '(:name "ann" :age 30) "people")
  (update-row 1 '(:age 31) "people")
  (delete-row 1 "people")
  (is (equal '((:insert "people" nil (:id 1 :name "ann" :age 30 :active :null))
               (:update "people" (:id 1 :name "ann" :age 30 :active :null)
                        (:id 1 :name "ann" :age 31 :active :null))
               (:delete "people" (:id 1 :name "ann" :age 31 :active :null) nil))
             (reverse *calls*))))

(def-test trigger-fires-only-for-its-events-and-timing (:fixture clean-db)
  (setf *calls* nil)
  (make-people)
  (create-trigger :on-update "people" :after :update 'note-call)
  (create-trigger :on-delete "people" :before '(:delete) 'note-call)
  (insert-row '(:name "ann") "people")
  (is (null *calls*))
  (update-row 1 '(:age 1) "people")
  (is (equal '(:update) (mapcar #'first *calls*)))
  (delete-row 1 "people")
  (is (equal '(:delete :update) (mapcar #'first *calls*))))

(def-test several-triggers-run-in-the-order-they-were-made (:fixture clean-db)
  (make-people)
  (make-audit)
  (create-trigger :a "people" :after :insert 'audit-trigger)
  (create-trigger :b "people" :after :insert 'audit-trigger)
  (insert-row '(:name "ann") "people")
  (is (equal '("insert" "insert") (audit-whats))))

;;; after triggers

(def-test after-trigger-writes-an-audit-row-in-the-same-transaction (:fixture clean-db)
  (make-people)
  (make-audit)
  (create-trigger :audit "people" :after '(:insert :update :delete) 'audit-trigger)
  (insert-row '(:name "ann") "people")
  (update-row 1 '(:age 5) "people")
  (delete-row 1 "people")
  (is (equal '("insert" "update" "delete") (audit-whats)))
  (with-transaction (insert-row '(:name "bob") "people") (rollback))
  (is (equal '("insert" "update" "delete") (audit-whats)) "the audit rows roll back with the change"))

(def-test after-trigger-sees-the-new-state (:fixture clean-db)
  (make-people)
  (let ((seen nil))
    (create-trigger :peek "people" :after :update
                    (lambda (event table old new)
                      (declare (ignore event table old))
                      (setf seen (getf (get-row (getf new :id) "people") :age))
                      nil))
    (insert-row '(:name "ann" :age 1) "people")
    (update-row 1 '(:age 2) "people")
    (is (= 2 seen))))

(def-test error-in-an-after-trigger-drops-the-change (:fixture clean-db)
  (make-people)
  (create-trigger :bad "people" :after :insert 'veto)
  (signals simple-error (insert-row '(:name "ann") "people"))
  (is (= 0 (count-rows "people")))
  (is (= 1 (progn (drop-trigger :bad "people") (insert-row '(:name "ann") "people")))
      "the dropped row gave its id back"))

;;; before triggers

(def-test before-trigger-changes-the-new-row (:fixture clean-db)
  (make-people)
  (create-trigger :up "people" :before '(:insert :update) 'upcase-name)
  (insert-row '(:name "ann") "people")
  (update-row 1 '(:name "bob") "people")
  (is (equal "BOB" (getf (get-row 1 "people") :name))))

(def-test before-trigger-changes-go-through-the-schema-checks (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:n integer)))
  (create-trigger :bad "t" :before :insert (lambda (e tb o n) (declare (ignore e tb o n)) (list :n "x")))
  (signals type-mismatch (insert-row '(:n 1) "t"))
  (drop-trigger :bad "t")
  (create-trigger :pk "t" :before :insert (lambda (e tb o n) (declare (ignore e tb o n)) (list :id 99)))
  (signals invalid-row (insert-row '(:n 1) "t"))
  (drop-trigger :pk "t")
  (create-trigger :nope "t" :before :insert (lambda (e tb o n) (declare (ignore e tb o n)) (list :zzz 1)))
  (signals no-such-column (insert-row '(:n 1) "t"))
  (is (= 0 (count-rows "t"))))

(def-test before-triggers-see-each-others-changes (:fixture clean-db)
  (make-people)
  (create-trigger :one "people" :before :insert 'touch-age)
  (create-trigger :two "people" :before :insert 'touch-age)
  (insert-row '(:name "ann" :age 10) "people")
  (is (= 12 (getf (get-row 1 "people") :age))))

(def-test before-trigger-can-veto (:fixture clean-db)
  (make-people)
  (create-trigger :no "people" :before '(:insert :update :delete) 'veto)
  (signals simple-error (insert-row '(:name "x") "people"))
  (drop-trigger :no "people")
  (insert-row '(:name "x") "people")
  (create-trigger :no "people" :before '(:update :delete) 'veto)
  (signals simple-error (update-row 1 '(:name "y") "people"))
  (signals simple-error (delete-row 1 "people"))
  (is (equal '("x") (names-of "people"))))

(def-test before-trigger-may-change-other-tables-but-not-its-own (:fixture clean-db)
  (make-people)
  (make-audit)
  (create-trigger :audit "people" :before :insert 'audit-trigger)
  (insert-row '(:name "ann") "people")
  (is (equal '("insert") (audit-whats)))
  (create-trigger :own "people" :before :insert 'insert-into-own-table)
  (signals trigger-error (insert-row '(:name "bob") "people"))
  (is (equal '("ann") (names-of "people")))
  (is (equal '("insert") (audit-whats)) "the failed change left no audit row"))

;;; cascades, bulk changes and depth

(def-test cascades-fire-triggers (:fixture clean-db)
  (setf *calls* nil)
  (make-owner-and-pets :cascade)
  (create-trigger :log "pets" :after '(:update :delete) 'note-call)
  (delete-row 1 "people")
  (is (equal '(:delete :delete) (mapcar #'first *calls*)) "rex and tom went with ann")
  (setf *calls* nil)
  (drop-table "pets")
  (make-table "pets" (list '(:id primary-key-column)
                           (list :owner 'foreign-key-column :references "people" :on-delete :set-null)
                           '(:pet string)))
  (create-trigger :log "pets" :after '(:update :delete) 'note-call)
  (insert-row '(:owner 2 :pet "kit") "pets")
  (delete-row 2 "people")
  (is (equal '((:update "pets" (:id 1 :owner 2 :pet "kit") (:id 1 :owner :null :pet "kit")))
             *calls*)))

(def-test bulk-changes-fire-triggers-per-row (:fixture clean-db)
  (make-people)
  (make-audit)
  (add-people)
  (create-trigger :audit "people" :after '(:update :delete) 'audit-trigger)
  (update-where "people" '(:active nil) :where '(= :age 30))
  (delete-where "people" :where t)
  (is (equal '("update" "update" "delete" "delete" "delete") (audit-whats))))

(def-test trigger-loops-are-stopped (:fixture clean-db)
  (make-table "looped" '((:id primary-key-column) (:name string)))
  (create-trigger :loop "looped" :after :insert 'insert-into-looped)
  (signals trigger-error (insert-row '(:name "go") "looped"))
  (is (= 0 (count-rows "looped"))))

;;; management

(def-test show-and-drop-triggers (:fixture clean-db)
  (make-people)
  (create-trigger "Mine" "people" :after '(:insert) 'note-call)
  (is (equal '((:name :mine :timing :after :events (:insert) :function note-call))
             (show-triggers "people")))
  (is-true (drop-trigger :mine "people"))
  (is-false (drop-trigger :mine "people"))
  (is (null (show-triggers "people"))))

(def-test trigger-errors (:fixture clean-db)
  (make-people)
  (create-trigger :a "people" :after :insert 'note-call)
  (signals schema-error (create-trigger :a "people" :after :insert 'note-call))
  (signals schema-error (create-trigger :b "people" :during :insert 'note-call))
  (signals schema-error (create-trigger :b "people" :after :explode 'note-call))
  (signals schema-error (create-trigger :b "people" :after '() 'note-call))
  (signals schema-error (create-trigger :b "people" :after :insert 'no-such-function))
  (signals schema-error (create-trigger :b "people" :after :insert 42))
  (signals no-such-table (create-trigger :b "nope" :after :insert 'note-call))
  (signals schema-error (create-trigger :b (progn (create-view "v" :from "people") "v") :after :insert 'note-call)))

(def-test trigger-changes-roll-back (:fixture clean-db)
  (make-people)
  (with-transaction (create-trigger :a "people" :after :insert 'note-call) (rollback))
  (is (null (show-triggers "people")))
  (create-trigger :a "people" :after :insert 'note-call)
  (with-transaction (drop-trigger :a "people") (rollback))
  (is (= 1 (length (show-triggers "people")))))

;;; files

(def-test triggers-survive-snapshot-log-and-checkpoint (:fixture clean-db)
  (make-people)
  (make-audit)
  (create-trigger :audit "people" :after :insert 'audit-trigger)
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (load-db path)))
  (insert-row '(:name "ann") "people")
  (is (equal '("insert") (audit-whats)) "restored from a snapshot")
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (clear-db)
      (open-db path)
      (make-people)
      (make-audit)
      (create-trigger :audit "people" :after :insert 'audit-trigger)
      (create-trigger :gone "people" :after :delete 'audit-trigger)
      (drop-trigger :gone "people")
      (restart-db path)
      (is (equal '(:audit) (mapcar (lambda (tr) (getf tr :name)) (show-triggers "people")))
          "from the log")
      (insert-row '(:name "bob") "people")
      (checkpoint)
      (restart-db path)
      (is (equal '(:audit) (mapcar (lambda (tr) (getf tr :name)) (show-triggers "people")))
          "from the snapshot")
      (insert-row '(:name "cat") "people")
      (is (equal '("insert" "insert") (audit-whats))))))

(def-test replaying-the-log-does-not-fire-triggers-again (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (make-people)
      (make-audit)
      (create-trigger :audit "people" :after :insert 'audit-trigger)
      (insert-row '(:name "ann") "people")
      (restart-db path)
      (is (equal '("insert") (audit-whats)) "the audit row was logged once, and replayed once"))))

(def-test lambda-trigger-works-in-memory-and-is-refused-on-save (:fixture clean-db)
  (make-people)
  (create-trigger :l "people" :after :insert (lambda (e tb o n) (declare (ignore e tb o n)) nil))
  (insert-row '(:name "ann") "people")
  (call-with-temp-file
    (lambda (path) (signals persistence-error (save-db path))))
  (with-temp-dir (dir)
    (clear-db)
    (open-db (merge-pathnames "t.db" dir))
    (make-people)
    (signals persistence-error
      (create-trigger :l "people" :after :insert (lambda (e tb o n) (declare (ignore e tb o n)) nil)))
    (is (null (show-triggers "people")))))
