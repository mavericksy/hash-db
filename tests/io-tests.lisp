(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defun make-everything (&optional (name "all"))
  (make-table name '((:id primary-key-column) (:s string) (:n number) (:f float) (:i integer)
                     (:b boolean) (:k keyword) (:ts timestamp) (:j json) (:a any))))

(defparameter *tricky-strings*
  (list "plain" "with, comma" "with \"quotes\"" "" " leading and trailing " "multi
line" (format nil "cr~Clf~C" #\Return #\Newline) "日本語 é" "a,b\"c\nd" "NULL" "true" "123" ":kw"))

(defun everything-rows (name &optional (columns '(:s :n :f :i :b :k :ts :j :a)))
  (mapcar (lambda (r) (loop for (k v) on r by #'cddr when (member k columns) append (list k v)))
          (row-list name)))

(defun fill-everything (name)
  (insert-row (list :s "a" :n 1/4 :f 0.1d0 :i -5 :b t :k :red :ts 3900000000 :j "{\"x\":[1,2]}"
                    :a "any text")
              name)
  (insert-row (list :s "b" :n 2.5d0 :f 100 :i 0 :b nil :k :blue :ts 0 :j "[]" :a 7) name)
  (insert-row '() name)
  (dolist (s *tricky-strings*)
    (insert-row (list :s s :n 7) name)))

;;; CSV

(def-test csv-round-trip-of-every-type (:fixture clean-db)
  (make-everything)
  (make-everything "copy")
  (fill-everything "all")
  (let ((text (with-output-to-string (out) (export-csv "all" out :columns '(:s :n :f :i :b :k :ts :j)))))
    (is (= 16 (with-input-from-string (in text)
                (import-csv "copy" in))))
    (is (equalp (everything-rows "all" '(:s :n :f :i :b :k :ts :j))
                (everything-rows "copy" '(:s :n :f :i :b :k :ts :j))))))

(def-test csv-output-format (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string) (:n number)))
  (insert-row '(:s "a,b" :n 1) "t")
  (insert-row '(:s "" :n 2.5d0) "t")
  (insert-row '(:s "say \"hi\"") "t")
  (insert-row '() "t")
  (is (equal (format nil "id,s,n~%1,\"a,b\",1~%2,\"\",2.5~%3,\"say \"\"hi\"\"\",~%4,,~%")
             (with-output-to-string (out) (export-csv "t" out))))
  (is (equal (format nil "1,\"a,b\"~%2,\"\"~%3,\"say \"\"hi\"\"\"~%4,~%")
             (with-output-to-string (out) (export-csv "t" out :columns '(:id :s) :header nil)))))

(def-test csv-null-and-empty-string-differ (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string)))
  (make-table "u" '((:id primary-key-column) (:s string)))
  (insert-row '(:s "") "t")
  (insert-row '() "t")
  (insert-row '(:s "x") "t")
  (with-input-from-string (in (with-output-to-string (out) (export-csv "t" out)))
    (import-csv "u" in))
  (is (equal '("" :null "x") (mapcar (lambda (r) (getf r :s)) (row-list "u")))))

(def-test csv-header-and-columns (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:a string) (:b integer) (:c string :default "dflt")))
  (flet ((import-text (text &rest args)
           (with-input-from-string (in text) (apply #'import-csv "t" in args))))
    (is (= 2 (import-text (format nil "b,a~%1,x~%2,y~%"))) "the header names the columns, in any order")
    (is (= 1 (import-text (format nil "x,9~%") :header nil :columns '(:a :b))))
    (is (= 1 (import-text (format nil "ignored,names~%p,8~%") :columns '(:a :b))) "the header is skipped")
    (is (= 1 (import-text (format nil "q,5~%") :header nil :columns '(:a :b))))
    (is (= 1 (import-text (format nil "z,,~%") :header nil)) "no header and no columns: all but the primary key")
    (is (equal '((:a "x" :b 1 :c "dflt") (:a "y" :b 2 :c "dflt") (:a "x" :b 9 :c "dflt")
                 (:a "p" :b 8 :c "dflt") (:a "q" :b 5 :c "dflt") (:a "z" :b :null :c :null))
               (everything-rows "t" '(:a :b :c)))
        "an empty field is NULL, not the default")))

(def-test csv-reads-other-line-ends-quirks-and-blank-lines (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string) (:n integer)))
  (flet ((import-text (text) (with-input-from-string (in text) (import-csv "t" in))))
    (is (= 2 (import-text (format nil "s,n~C~Ca,1~C~Cb,2" #\Return #\Newline #\Return #\Newline))) "CRLF, no last newline")
    (is (= 2 (import-text (format nil "s,n~Cc,3~Cd,4~C" #\Return #\Return #\Return))) "CR")
    (is (= 1 (import-text (format nil "s,n~%~%e,5~%~%"))) "blank lines")
    (is (= 1 (import-text (format nil "~Cs,n~%f,6~%" (code-char #xFEFF)))) "a byte order mark")
    (is (= 1 (import-text (format nil "s,n~%\"multi~%line\",7~%"))) "a line break inside quotes")
    (is (equal (format nil "multi~%line") (getf (car (last (row-list "t"))) :s)))
    (is (= 0 (import-text (format nil "s,n~%"))) "a header and nothing else")))

(def-test csv-errors-name-the-line (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string :unique t) (:n integer) (:b boolean)
                    (:f float) (:k keyword)))
  (flet ((fails (text &rest args)
           (handler-case (with-input-from-string (in text) (apply #'import-csv "t" in args) nil)
             (import-error (c) (error-line c)))))
    (is (eql 3 (fails (format nil "s,n~%a,1~%b,notanumber~%"))))
    (is (eql 2 (fails (format nil "s,n~%a,1.5~%")) ) "a fraction in an integer column")
    (is (eql 2 (fails (format nil "s,b~%a,maybe~%"))))
    (is (eql 2 (fails (format nil "s,f~%a,x1~%"))))
    (is (eql 2 (fails (format nil "s,n~%a,1,2~%"))) "too many fields")
    (is (eql 2 (fails (format nil "s,n~%a~%"))) "too few fields")
    (is (eql 1 (fails (format nil "s,nope~%a,1~%"))) "an unknown column in the header")
    (is (eql 1 (fails (format nil "s,s~%a,b~%"))) "a column named twice")
    (is (eql 2 (fails (format nil "s,n~%\"never closed,1~%"))) "a quote that never closes")
    (is (eql 2 (fails (format nil "s,n~%\"a\"x,1~%"))) "text after a closing quote")
    (is (eql 2 (fails (format nil "s,n~%a\"b,1~%"))) "a quote in an unquoted field")
    (is (eql nil (fails "")) "an empty file with no header")
    (is (= 0 (count-rows "t")) "nothing went in")))

(def-test csv-import-is-all-or-nothing (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string :unique t)))
  (insert-row '(:s "keep") "t")
  (handler-case (with-input-from-string (in (format nil "s~%new~%keep~%later~%"))
                  (import-csv "t" in))
    (import-error (c)
      (is (eql 3 (error-line c)))
      (is (search "Duplicate" (error-message c)))))
  (is (equal '("keep") (mapcar (lambda (r) (getf r :s)) (row-list "t")))))

(def-test csv-ignores-primary-key-values (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string)))
  (with-input-from-string (in (format nil "id,s~%50,a~%60,b~%"))
    (is (= 2 (import-csv "t" in))))
  (is (equal '((:id 1 :s "a") (:id 2 :s "b")) (row-list "t"))))

(def-test csv-errors-without-a-table-or-for-a-view (:fixture clean-db)
  (make-people)
  (create-view "v" :from "people")
  (signals no-such-table (export-csv "nope" (make-string-output-stream)))
  (signals schema-error (with-input-from-string (in "a") (import-csv "v" in)))
  (signals no-such-column (export-csv "people" (make-string-output-stream) :columns '(:nope))))

(def-test export-works-for-views-and-select-results (:fixture clean-db)
  (make-sample-people)
  (create-view "old" :from "people" :where '(>= :age 30) :col '(:name :age) :order-by :id)
  (is (equal (format nil "name,age~%ann,30~%cat,30~%Eve,41~%")
             (with-output-to-string (out) (export-csv "old" out))))
  (let ((result (select :from "people" :col '(:name (as (+ :age 1) :next)) :where '(= :id 1))))
    (is (equal (format nil "name,next~%ann,31~%")
               (with-output-to-string (out) (export-csv result out))))))

(def-test export-csv-to-a-path-is-atomic (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string)))
  (insert-row '(:s "a") "t")
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.csv" dir)))
      (is (= 1 (export-csv "t" path)))
      (is (equal (format nil "id,s~%1,a~%") (uiop:read-file-string path)))
      (insert-row '(:s "b") "t")
      (export-csv "t" path)
      (is (equal (format nil "id,s~%1,a~%2,b~%") (uiop:read-file-string path)))
      (is (null (probe-file (concatenate 'string (namestring path) ".tmp"))))
      (make-table "u" '((:id primary-key-column) (:s string)))
      (is (= 2 (import-csv "u" path)))
      (is (= 2 (import-csv "u" (namestring path)))))))

(def-test csv-import-of-many-rows (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string) (:n integer)))
  (let ((text (with-output-to-string (out)
                (format out "s,n~%")
                (dotimes (i 5000) (format out "row ~D,~D~%" i i)))))
    (is (= 5000 (with-input-from-string (in text) (import-csv "t" in))))
    (is (equal '(:s "row 4999" :n 4999) (cddr (car (last (row-list "t"))))))))

;;; JSON

(def-test json-round-trip-of-every-type (:fixture clean-db)
  (make-everything)
  (make-everything "copy")
  (fill-everything "all")
  (let ((text (with-output-to-string (out) (export-json "all" out))))
    (is (= 16 (with-input-from-string (in text) (import-json "copy" in))))
    (is (equalp (everything-rows "all") (everything-rows "copy")))))

(def-test json-output-format (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string) (:k keyword) (:b boolean) (:j json) (:r number)))
  (insert-row '(:s "a" :k :red :b t :j "{\"x\":1}" :r 1/2) "t")
  (insert-row '() "t")
  (is (equal (format nil "[~%{\"id\":1,\"s\":\"a\",\"k\":\"red\",\"b\":true,\"j\":{\"x\":1},\"r\":0.5},~%{\"id\":2,\"s\":null,\"k\":null,\"b\":null,\"j\":null,\"r\":null}~%]~%")
             (with-output-to-string (out) (export-json "t" out))))
  (is (equal (format nil "[]~%") (with-output-to-string (out) (export-json (select :from "t" :where '(= :id 99)) out))))
  (is (equal (format nil "[~%{\"s\":\"a\"},~%{\"s\":null}~%]~%")
             (with-output-to-string (out) (export-json "t" out :columns :s)))))

(def-test json-import-maps-keys-and-values (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:name string) (:age integer) (:ok boolean) (:k keyword)
                    (:doc json) (:note string :default "none")))
  (let ((text "[{\"Name\":\"ann\",\"age\":30,\"ok\":true,\"k\":\"red\",\"doc\":{\"a\":[1,2]}},
                {\"name\":\"bob\",\"ok\":false,\"doc\":\"just a string\",\"id\":99,\"note\":null},
                {}]"))
    (is (= 3 (with-input-from-string (in text) (import-json "t" in)))))
  (is (equal '((:id 1 :name "ann" :age 30 :ok t :k :red :doc "{\"a\":[1,2]}" :note "none")
               (:id 2 :name "bob" :age :null :ok nil :k :null :doc "\"just a string\"" :note :null)
               (:id 3 :name :null :age :null :ok :null :k :null :doc :null :note "none"))
             (row-list "t"))))

(def-test json-import-errors (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:name string :unique t) (:age integer) (:doc json)))
  (flet ((fails (text)
           (handler-case (with-input-from-string (in text) (import-json "t" in) nil)
             (import-error (c) (list :error (error-line c))))))
    (is (equal '(:error nil) (fails "not json")))
    (is (equal '(:error nil) (fails "{\"name\":\"a\"}")) "an object, not an array")
    (is (equal '(:error nil) (fails "\"text\"")))
    (is (equal '(:error 2) (fails "[{}, 5]")))
    (is (equal '(:error 1) (fails "[{\"nope\":1}]")))
    (is (equal '(:error 2) (fails "[{\"name\":\"a\"},{\"name\":\"a\"}]")))
    (is (equal '(:error 1) (fails "[{\"age\":\"old\"}]")))
    (is (equal '(:error 1) (fails "[{\"age\":[1]}]")) "an array in an integer column")
    (is (equal '(:error 1) (fails "[{\"name\":{\"x\":1}}]")))
    (is (= 0 (count-rows "t")) "nothing went in")
    (is (= 1 (with-input-from-string (in "[{\"doc\":[1,{\"a\":null}]}]") (import-json "t" in))))
    (is (equal "[1,{\"a\":null}]" (getf (get-row 1 "t") :doc)))
    (is (= 0 (with-input-from-string (in "[]") (import-json "t" in))))))

(def-test json-export-and-import-through-a-path (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:s string)))
  (make-table "u" '((:id primary-key-column) (:s string)))
  (insert-row '(:s "日本 \"q\"") "t")
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.json" dir)))
      (export-json "t" path)
      (is (= 1 (import-json "u" path)))
      (is (equal "日本 \"q\"" (getf (get-row 1 "u") :s))))))

(def-test import-reaches-the-log-and-fires-triggers (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (make-people)
      (make-audit)
      (create-trigger :audit "people" :after :insert 'audit-trigger)
      (with-input-from-string (in (format nil "name,age~%ann,30~%bob,25~%"))
        (import-csv "people" in))
      (restart-db path)
      (is (= 2 (count-rows "people")))
      (is (equal '("insert" "insert") (audit-whats))))))
