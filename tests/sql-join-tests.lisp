(in-package #:hash-db-tests)

(in-suite hash-db-suite)

;; The pet world of the query tests: people ann (1), bob (2), cat (3); pets rex and tom
;; belong to ann, kit to cat, stray to nobody; toy ball is rex's, bone is kit's.

(defun pairs (rows &rest keys)
  (mapcar (lambda (r) (mapcar (lambda (k) (getf r k)) keys)) rows))

(def-test sql-inner-join (:fixture clean-db)
  (make-pet-world)
  (is (equal '(("ann" "rex") ("ann" "tom") ("cat" "kit"))
             (pairs (q "SELECT p.name, pt.pet FROM people p JOIN pets pt ON p.id = pt.owner") :name :pet)))
  (is (equal '(("ann" "rex") ("ann" "tom") ("cat" "kit"))
             (pairs (q "SELECT name, pet FROM people INNER JOIN pets ON people.id = pets.owner") :name :pet))
      "the table names are the qualifiers when there is no alias")
  (is (equal '(("ann" "rex") ("ann" "tom") ("cat" "kit"))
             (pairs (q "SELECT name, pet FROM people JOIN pets ON owner = id") :name :pet))
      "names that are in one table only need no prefix"))

(def-test sql-outer-joins (:fixture clean-db)
  (make-pet-world)
  (is (equal '(("ann" "rex") ("ann" "tom") ("bob" :null) ("cat" "kit"))
             (pairs (q "SELECT name, pet FROM people LEFT JOIN pets ON people.id = pets.owner") :name :pet)))
  (is (equal '(("ann" "rex") ("ann" "tom") ("bob" :null) ("cat" "kit"))
             (pairs (q "SELECT name, pet FROM people LEFT OUTER JOIN pets ON people.id = pets.owner") :name :pet)))
  (is (equal '(("ann" "rex") ("ann" "tom") ("cat" "kit") (:null "stray"))
             (pairs (q "SELECT name, pet FROM people RIGHT JOIN pets ON people.id = pets.owner") :name :pet)))
  (is (equal '(("ann" "rex") ("ann" "tom") ("bob" :null) ("cat" "kit") (:null "stray"))
             (pairs (q "SELECT name, pet FROM people FULL OUTER JOIN pets ON people.id = pets.owner") :name :pet))))

(def-test sql-join-condition-in-either-order (:fixture clean-db)
  (make-pet-world)
  (is (equal (q "SELECT name, pet FROM people p JOIN pets x ON p.id = x.owner")
             (q "SELECT name, pet FROM people p JOIN pets x ON x.owner = p.id"))))

(def-test sql-join-chain (:fixture clean-db)
  (make-pet-world)
  (is (equal '(("ann" "rex" "ball") ("ann" "tom" :null) ("cat" "kit" "bone"))
             (pairs (q "SELECT p.name, pt.pet, t.toy
                        FROM people p
                        JOIN pets pt ON p.id = pt.owner
                        LEFT JOIN toys t ON pt.pet_id = t.pet_ref")
                    :name :pet :toy))
      "a later ON can name a table that was joined before")
  (is (equal '(("ann" "rex" "ball") ("ann" "tom" :null) ("cat" "kit" "bone"))
             (pairs (q "SELECT name, pet, toy FROM people JOIN pets ON people.id = owner LEFT JOIN toys ON pets.pet_id = pet_ref")
                    :name :pet :toy))))

(def-test sql-star-with-joins-names-columns-plainly (:fixture clean-db)
  (make-pet-world)
  (let ((rows (q "SELECT * FROM people p JOIN pets pt ON p.id = pt.owner WHERE pt.pet = 'kit'")))
    (is (equal '((:id 3 :name "cat" :age 30 :active t :pet-id 3 :owner 3 :pet "kit")) rows)))
  (let ((rows (q "SELECT pt.* FROM people p JOIN pets pt ON p.id = pt.owner WHERE pt.pet = 'kit'")))
    (is (equal '((:pet-id 3 :owner 3 :pet "kit")) rows)))
  (let ((rows (q "SELECT p.*, pt.pet FROM people p JOIN pets pt ON p.id = pt.owner WHERE pt.pet = 'kit'")))
    (is (equal '((:id 3 :name "cat" :age 30 :active t :pet "kit")) rows))))

(def-test sql-repeated-column-names-are-qualified (:fixture clean-db)
  (make-table "a" '((:id primary-key-column) (:name string)))
  (make-table "b" '((:id primary-key-column) (:a-id integer) (:name string)))
  (insert-row '(:name "left") "a")
  (insert-row '(:a-id 1 :name "right") "b")
  (is (equal '((:a.id 1 :b.id 1 :a.name "left" :b.name "right"))
             (q "SELECT a.id, b.id, a.name, b.name FROM a JOIN b ON a.id = b.a_id")))
  (is (equal '((:id 1 :a-id 1 :a.name "left" :b.name "right"))
             (q "SELECT b.id, b.a_id, a.name, b.name FROM a JOIN b ON a.id = b.a_id"))
      "b.id and the others are not repeated, so they stay plain. The two names are")
  (is (equal '((:x "left" :y "right"))
             (q "SELECT a.name AS x, b.name AS y FROM a JOIN b ON a.id = b.a_id")))
  (is (equal '((:a.id 1 :a.name "left" :b.id 1 :a-id 1 :b.name "right"))
             (q "SELECT * FROM a JOIN b ON a.id = b.a_id"))))

(def-test sql-self-join (:fixture clean-db)
  (make-table "nodes" (list '(:id primary-key-column) '(:label string)
                            (list :parent 'foreign-key-column :references "nodes")))
  (insert-row '(:label "root") "nodes")
  (insert-row '(:label "child" :parent 1) "nodes")
  (insert-row '(:label "grandchild" :parent 2) "nodes")
  (is (equal '(("child" "root") ("grandchild" "child"))
             (pairs (q "SELECT c.label AS child, p.label AS parent FROM nodes c JOIN nodes p ON c.parent = p.id ORDER BY c.id")
                    :child :parent)))
  (is (equal '((:c.label "child" :p.label "root") (:c.label "grandchild" :p.label "child"))
             (q "SELECT c.label, p.label FROM nodes c JOIN nodes p ON c.parent = p.id ORDER BY c.id")))
  (signals sql-error (q "SELECT label FROM nodes c JOIN nodes p ON c.parent = p.id"))
  (signals sql-error (q "SELECT * FROM nodes JOIN nodes ON nodes.parent = nodes.id") "two tables with one name"))

(def-test sql-join-where-order-group-limit (:fixture clean-db)
  (make-pet-world)
  (is (equal '("ann") (mapcar (lambda (r) (getf r :name))
                              (q "SELECT DISTINCT p.name FROM people p JOIN pets pt ON p.id = pt.owner WHERE pt.pet LIKE 't%'"))))
  (is (equal '(("ann" "rex") ("cat" "kit"))
             (pairs (q "SELECT p.name, pt.pet FROM people p JOIN pets pt ON p.id = pt.owner ORDER BY pt.pet DESC LIMIT 2 OFFSET 1")
                    :name :pet)))
  (is (equal '((:name "ann" :pets 2) (:name "cat" :pets 1) (:name "bob" :pets 0))
             (q "SELECT p.name, count(pt.pet) AS pets FROM people p LEFT JOIN pets pt ON p.id = pt.owner
                 GROUP BY p.name ORDER BY pets DESC, p.name")))
  (is (equal '((:name "ann" :pets 2))
             (q "SELECT p.name, count(*) AS pets FROM people p JOIN pets pt ON p.id = pt.owner
                 GROUP BY p.name HAVING count(*) > 1")))
  (is (equal '(("bob" :null))
             (pairs (q "SELECT p.name, pt.pet FROM people p LEFT JOIN pets pt ON p.id = pt.owner WHERE pt.pet IS NULL")
                    :name :pet))
      "people without a pet"))

(def-test sql-join-matches-the-hand-written-select (:fixture clean-db)
  (make-pet-world)
  (is (equal (row-list (select :from "people" :left-join '("pets" :id :owner :as "pt")
                               :col '(:name :pt.pet) :order-by :pt.pet))
             (mapcar (lambda (r) (list :name (getf r :name) :pt.pet (getf r :pet)))
                     (q "SELECT p.name, pt.pet FROM people p LEFT JOIN pets pt ON p.id = pt.owner ORDER BY pt.pet"))
             )
      "the same rows under the names that SQL gives"))

(def-test sql-join-uses-the-index-and-planner (:fixture clean-db)
  (make-pet-world)
  (dotimes (i 40) (insert-row (list :owner 1 :pet "filler") "pets"))
  (let* ((args (hash-db::translate-select
                (first (hash-db::sql-parse "SELECT p.name, pt.pet FROM people p JOIN pets pt ON p.id = pt.owner WHERE p.id = 1"))))
         (steps (apply #'explain args)))
    (is (equal '(:primary-key :eq) (list (getf (cddr (first steps)) :index) (getf (cddr (first steps)) :op))))
    (is (equal '(:index :owner-fk) (let ((j (find :join steps :key #'second)))
                                      (list (getf (cddr j) :method) (getf (cddr j) :index)))))))

(def-test sql-join-over-views (:fixture clean-db)
  (make-pet-world)
  (create-view "adults" :from "people" :where '(>= :age 30))
  (is (equal '(("ann" "rex") ("ann" "tom") ("cat" "kit"))
             (pairs (q "SELECT a.name, pt.pet FROM adults a JOIN pets pt ON a.id = pt.owner") :name :pet))))

(def-test sql-join-errors (:fixture clean-db)
  (make-pet-world)
  (flet ((fails (text)
           (handler-case (progn (sql text) nil)
             (sql-error (c) (error-message c)))))
    (is (search "Expected ON" (fails "SELECT * FROM people JOIN pets")))
    (is (search "USING is not supported" (fails "SELECT * FROM people JOIN pets USING (id)")))
    (is (search "CROSS JOIN is not supported" (fails "SELECT * FROM people CROSS JOIN pets")))
    (is (search "NATURAL JOIN is not supported" (fails "SELECT * FROM people NATURAL JOIN pets")))
    (is (search "list of tables" (fails "SELECT * FROM people, pets")))
    (is (search "one equality" (fails "SELECT * FROM people p JOIN pets pt ON p.id < pt.owner")))
    (is (search "one equality" (fails "SELECT * FROM people p JOIN pets pt ON p.id = pt.owner AND pt.pet = 'x'")))
    (is (search "one equality" (fails "SELECT * FROM people p JOIN pets pt ON p.id = 1")))
    (is (search "must compare a column of the tables before" (fails "SELECT * FROM people p JOIN pets pt ON pt.owner = pt.pet_id")))
    (is (search "must compare a column of the tables before" (fails "SELECT * FROM people p JOIN pets pt ON p.id = p.age")))
    (is (search "has no column nope" (fails "SELECT * FROM people p JOIN pets pt ON p.nope = pt.owner")))
    (is (search "Unknown column nope" (fails "SELECT * FROM people p JOIN pets pt ON nope = pt.owner")))
    (is (search "Unknown table or alias" (fails "SELECT * FROM people p JOIN pets pt ON x.id = pt.owner")))
    (is (search "more than one table" (fails "SELECT id FROM people p JOIN toys t ON p.id = t.pet_ref JOIN people q ON q.id = t.toy_id")))
    (is (search "Unknown table or alias" (fails "SELECT zzz.name FROM people p JOIN pets pt ON p.id = pt.owner")))
    (signals no-such-table (sql "SELECT * FROM people JOIN nope ON people.id = nope.x"))))
