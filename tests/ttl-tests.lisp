(in-package #:hash-db-tests)

(in-suite hash-db-suite)

;; Set the clock for the body. It is set, not bound, so other threads see it too.
(defmacro with-clock ((time) &body body)
  `(let ((old hash-db::*clock*))
     (setf hash-db::*clock* (lambda () ,time))
     (unwind-protect (progn ,@body)
       (setf hash-db::*clock* old))))

(defun make-sessions ()
  (make-table "sessions" '((:id primary-key-column) (:user string) (:expires timestamp)))
  (set-ttl "sessions" :expires))

(defun users ()
  (mapcar (lambda (r) (getf r :user)) (row-list "sessions")))

(def-test purge-deletes-rows-whose-time-has-come (:fixture clean-db)
  (make-sessions)
  (insert-row '(:user "old" :expires 100) "sessions")
  (insert-row '(:user "edge" :expires 200) "sessions")
  (insert-row '(:user "later" :expires 300) "sessions")
  (insert-row '(:user "never") "sessions")
  (with-clock (200)
    (is (= 2 (purge-expired))))
  (is (equal '("later" "never") (users)))
  (with-clock (1000)
    (is (= 1 (purge-expired :table "sessions"))))
  (is (equal '("never") (users)))
  (is (= 0 (purge-expired))))

(def-test expires-in-uses-the-clock (:fixture clean-db)
  (make-sessions)
  (with-clock (1000)
    (is (= 1060 (expires-in 60)))
    (insert-row (list :user "ann" :expires (expires-in 60)) "sessions"))
  (with-clock (1059) (is (= 0 (purge-expired))))
  (with-clock (1060) (is (= 1 (purge-expired))))
  (is (null (users))))

(def-test expired-rows-stay-visible-until-purged (:fixture clean-db)
  (make-sessions)
  (insert-row '(:user "old" :expires 100) "sessions")
  (with-clock (500)
    (is (equal '("old") (users)))
    (is (= 0 (count-rows (select :from "sessions" :where '(> :expires (fn get-universal-time))))))
    (is (= 0 (count-rows (select :from "sessions" :where (list '> :expires (now))))))))

(def-test set-ttl-makes-an-index-and-purge-uses-it (:fixture clean-db)
  (make-sessions)
  (is (eq :expires (ttl-column "sessions")))
  (is (equal '(:expires-index) (index-names "sessions")))
  (dotimes (i 20) (insert-row (list :user (format nil "u~D" i) :expires (* i 10)) "sessions"))
  (let ((step (first (explain :from "sessions" :where '(<= :expires 50)))))
    (is (equal '(:index :range 6) (list (getf (cddr step) :access) (getf (cddr step) :op) (getf (cddr step) :rows))))
    )
  (with-clock (50) (is (= 6 (purge-expired))))
  (is (= 14 (count-rows "sessions")))
  (is (indexes-match-rows-p)))

(def-test set-ttl-keeps-an-index-that-exists (:fixture clean-db)
  (make-table "s" '((:id primary-key-column) (:e timestamp)))
  (create-index "s" :e :name :mine)
  (set-ttl "s" :e)
  (is (equal '(:mine) (index-names "s"))))

(def-test clear-ttl-stops-expiry (:fixture clean-db)
  (make-sessions)
  (insert-row '(:user "old" :expires 100) "sessions")
  (is-true (clear-ttl "sessions"))
  (is-false (clear-ttl "sessions"))
  (is (null (ttl-column "sessions")))
  (with-clock (500) (is (= 0 (purge-expired)))))

(def-test purge-fires-triggers-and-cascades (:fixture clean-db)
  (make-table "sessions" '((:id primary-key-column) (:user string) (:expires timestamp)))
  (make-table "items" (list '(:id primary-key-column)
                            (list :session 'foreign-key-column :references "sessions" :on-delete :cascade)))
  (make-audit)
  (set-ttl "sessions" :expires)
  (create-trigger :audit "sessions" :after :delete 'audit-trigger)
  (insert-row '(:user "a" :expires 10) "sessions")
  (insert-row '(:session 1) "items")
  (insert-row '(:session 1) "items")
  (with-clock (10) (is (= 1 (purge-expired))))
  (is (= 0 (count-rows "items")))
  (is (equal '("delete") (audit-whats))))

(def-test purge-is-all-or-nothing (:fixture clean-db)
  (make-table "parents" '((:id primary-key-column) (:expires timestamp)))
  (make-table "kids" '((:id primary-key-column) (:p foreign-key-column :references "parents")))
  (set-ttl "parents" :expires)
  (insert-row '(:expires 5) "parents")
  (insert-row '(:expires 6) "parents")
  (insert-row '(:p 2) "kids")
  (with-clock (10)
    (signals foreign-key-violation (purge-expired)))
  (is (= 2 (count-rows "parents")) "the first row was not purged either"))

(def-test ttl-errors (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:n integer) (:e timestamp)))
  (signals schema-error (set-ttl "t" :n))
  (signals no-such-column (set-ttl "t" :nope))
  (signals no-such-table (set-ttl "nope" :e))
  (signals no-such-table (purge-expired :table "nope"))
  (is (= 0 (purge-expired :table "t")) "a table without a ttl has nothing to purge"))

(def-test ttl-changes-roll-back (:fixture clean-db)
  (make-table "t" '((:id primary-key-column) (:e timestamp)))
  (with-transaction (set-ttl "t" :e) (rollback))
  (is (null (ttl-column "t")))
  (is (null (index-names "t")) "the index rolled back too"))

(def-test ttl-survives-snapshot-log-and-checkpoint (:fixture clean-db)
  (make-sessions)
  (insert-row '(:user "old" :expires 100) "sessions")
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (load-db path)))
  (is (eq :expires (ttl-column "sessions")))
  (with-clock (200) (is (= 1 (purge-expired))))
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (clear-db)
      (open-db path)
      (make-sessions)
      (insert-row '(:user "a" :expires 100) "sessions")
      (insert-row '(:user "b" :expires 900) "sessions")
      (with-clock (200) (purge-expired))
      (restart-db path)
      (is (eq :expires (ttl-column "sessions")) "from the log")
      (is (equal '("b") (users)) "the purge was logged")
      (checkpoint)
      (restart-db path)
      (is (eq :expires (ttl-column "sessions")) "from the snapshot")
      (clear-ttl "sessions")
      (restart-db path)
      (is (null (ttl-column "sessions"))))))

;;; the sweeper

(def-test sweeper-purges-in-the-background (:fixture clean-db)
  (make-sessions)
  (insert-row '(:user "old" :expires 100) "sessions")
  (insert-row '(:user "new" :expires 900) "sessions")
  (with-clock (500)
    (is-true (start-sweeper :interval 0.05))
    (unwind-protect
         (loop repeat 100
               until (equal '("new") (users))
               do (sleep 0.05))
      (stop-sweeper)))
  (is (equal '("new") (users))))

(def-test sweeper-rules (:fixture clean-db)
  (is-false (stop-sweeper))
  (signals schema-error (start-sweeper :interval 0))
  (signals schema-error (start-sweeper :interval "x"))
  (start-sweeper :interval 60)
  (signals schema-error (start-sweeper :interval 60))
  (let ((start (get-internal-real-time)))
    (is-true (stop-sweeper))
    (is (< (- (get-internal-real-time) start) internal-time-units-per-second)
        "stopping does not wait for the interval"))
  (is-false (stop-sweeper))
  (finishes (start-sweeper :interval 60))
  (stop-sweeper))

(def-test sweeper-survives-an-error (:fixture clean-db)
  (make-sessions)
  (insert-row '(:user "old" :expires 100) "sessions")
  (let ((first t) (errors '()))
    (with-clock ((if first (progn (setf first nil) (error "clock broke")) 500))
      (start-sweeper :interval 0.05 :on-error (lambda (c) (push (princ-to-string c) errors)))
      (unwind-protect
           (loop repeat 100 until (null (users)) do (sleep 0.05))
        (stop-sweeper))
      (is (null (users)) "the next sweep worked")
      (is (equal '("clock broke") errors)))))
