(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defun make-sql-people ()
  (make-table "people" '((:id primary-key-column) (:name string :unique t :not-null t) (:age integer :check (>= :age 0))
                         (:active boolean :default t) (:note string :default "none"))))

(defun people-rows () (row-list (select :from "people" :order-by :id)))

;;; INSERT

(def-test sql-insert-with-a-column-list (:fixture clean-db)
  (make-sql-people)
  (multiple-value-bind (count last-id) (sql "INSERT INTO people (name, age) VALUES ('ann', 30)")
    (is (= 1 count))
    (is (= 1 last-id)))
  (is (equal '((:id 1 :name "ann" :age 30 :active t :note "none")) (people-rows)) "defaults apply")
  (is (equal '(1 2) (multiple-value-list (sql "insert into People (age, name) values (?, ?)" 25 "bob"))))
  (is (equal "bob" (getf (get-row 2 "people") :name))))

(def-test sql-insert-several-rows-and-expressions (:fixture clean-db)
  (make-sql-people)
  (multiple-value-bind (count last-id)
      (sql "INSERT INTO people (name, age) VALUES ('a', 1 + 2), ('b', ?), ('c', -4 + 10), (lower('D'), NULL)" 7)
    (is (= 4 count))
    (is (= 4 last-id)))
  (is (equal '("a" "b" "c" "d") (mapcar (lambda (r) (getf r :name)) (people-rows))))
  (is (equal '(3 7 6 :null) (mapcar (lambda (r) (getf r :age)) (people-rows)))))

(def-test sql-insert-without-a-column-list-fills-all-but-the-primary-key (:fixture clean-db)
  (make-sql-people)
  (sql "INSERT INTO people VALUES ('ann', 30, FALSE, 'hi')")
  (is (equal '((:id 1 :name "ann" :age 30 :active nil :note "hi")) (people-rows)))
  (signals sql-error (sql "INSERT INTO people VALUES ('bob', 30)")))

(def-test sql-insert-default-and-null (:fixture clean-db)
  (make-sql-people)
  (sql "INSERT INTO people (name, active, note) VALUES ('ann', DEFAULT, NULL)")
  (is (equal '((:id 1 :name "ann" :age :null :active t :note :null)) (people-rows))
      "DEFAULT leaves the column out, and NULL is NULL"))

(def-test sql-insert-values-are-data (:fixture clean-db)
  (make-sql-people)
  (sql "INSERT INTO people (name) VALUES (?)" "Robert'); DROP TABLE people;--")
  (is (equal '("Robert'); DROP TABLE people;--") (mapcar (lambda (r) (getf r :name)) (people-rows))))
  (sql "INSERT INTO people (name) VALUES ('it''s')")
  (is (equal "it's" (getf (get-row 2 "people") :name))))

(def-test sql-insert-sequences-and-now (:fixture clean-db)
  (create-sequence "n" :start 100)
  (make-table "t" '((:id primary-key-column) (:no integer) (:at timestamp)))
  (with-clock (5000)
    (sql "INSERT INTO t (no, at) VALUES (nextval('n'), now()), (nextval('n'), CURRENT_TIMESTAMP)"))
  (is (equal '((:id 1 :no 100 :at 5000) (:id 2 :no 101 :at 5000)) (row-list "t"))))

(def-test sql-insert-errors-are-the-usual-errors (:fixture clean-db)
  (make-sql-people)
  (sql "INSERT INTO people (name) VALUES ('ann')")
  (signals unique-violation (sql "INSERT INTO people (name) VALUES ('ann')"))
  (signals not-null-violation (sql "INSERT INTO people (age) VALUES (3)"))
  (signals check-violation (sql "INSERT INTO people (name, age) VALUES ('x', -1)"))
  (signals type-mismatch (sql "INSERT INTO people (name, age) VALUES ('x', 'old')"))
  (signals invalid-row (sql "INSERT INTO people (id, name) VALUES (9, 'x')"))
  (signals sql-error (sql "INSERT INTO people (nope) VALUES (1)"))
  (signals sql-error (sql "INSERT INTO people (name, name) VALUES ('a', 'b')"))
  (signals sql-error (sql "INSERT INTO people (name) VALUES ('a', 'b')"))
  (signals sql-error (sql "INSERT INTO people (name, age) VALUES ('a')"))
  (signals sql-error (sql "INSERT INTO people (name) VALUES (age)") "no columns in a VALUES")
  (signals sql-error (sql "INSERT INTO people (name) VALUES"))
  (signals sql-error (sql "INSERT people (name) VALUES ('a')"))
  (signals no-such-table (sql "INSERT INTO nope (a) VALUES (1)"))
  (is (= 1 (count-rows "people"))))

(def-test sql-insert-is-all-or-nothing (:fixture clean-db)
  (make-sql-people)
  (signals unique-violation (sql "INSERT INTO people (name) VALUES ('a'), ('b'), ('a')"))
  (is (= 0 (count-rows "people")))
  (is (= 1 (insert-row '(:name "x") "people")) "the ids came back too"))

(def-test sql-insert-into-a-view-is-refused (:fixture clean-db)
  (make-sql-people)
  (create-view "v" :from "people")
  (signals schema-error (sql "INSERT INTO v (name) VALUES ('a')")))

(def-test sql-insert-select (:fixture clean-db)
  (make-sql-people)
  (make-table "archive" '((:id primary-key-column) (:name string) (:age integer)))
  (sql "INSERT INTO people (name, age) VALUES ('ann', 30), ('bob', 25), ('cat', 41)")
  (is (equal '(2 2) (multiple-value-list (sql "INSERT INTO archive (name, age) SELECT name, age FROM people WHERE age >= ?" 30))))
  (is (equal '(("ann" 30) ("cat" 41)) (pairs (row-list "archive") :name :age)))
  (sql "INSERT INTO archive SELECT upper(name) AS n, age + 1 FROM people WHERE age < 30")
  (is (equal '("BOB" 26) (let ((r (car (last (row-list "archive"))))) (list (getf r :name) (getf r :age)))))
  (signals sql-error (sql "INSERT INTO archive (name) SELECT name, age FROM people"))
  (is (equal '(3 6) (multiple-value-list (sql "INSERT INTO people (name, age) SELECT name || '2', age FROM people")))
      "the SELECT reads the table as it was, so the new rows are not read again")
  (is (= 6 (count-rows "people"))))

(def-test sql-insert-fires-triggers-and-reaches-the-log (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (make-people)
      (make-audit)
      (create-trigger :audit "people" :after :insert 'audit-trigger)
      (sql "INSERT INTO people (name, age) VALUES ('ann', 30), ('bob', 25)")
      (restart-db path)
      (is (= 2 (count-rows "people")))
      (is (equal '("insert" "insert") (audit-whats))))))

;;; UPDATE

(defun make-three-people ()
  (make-sql-people)
  (sql "INSERT INTO people (name, age) VALUES ('ann', 30), ('bob', 25), ('cat', 30)"))

(def-test sql-update (:fixture clean-db)
  (make-three-people)
  (is (= 2 (sql "UPDATE people SET active = FALSE WHERE age = 30")))
  (is (equal '(nil t nil) (mapcar (lambda (r) (getf r :active)) (people-rows))))
  (is (= 1 (sql "UPDATE people SET age = age + 1, note = upper(name) || ? WHERE name = ?" "!" "bob")))
  (is (equal '(:age 26 :note "BOB!") (let ((r (get-row 2 "people"))) (list :age (getf r :age) :note (getf r :note)))))
  (is (= 3 (sql "UPDATE people SET note = 'all'")) "no WHERE means every row")
  (is (equal '("all" "all" "all") (mapcar (lambda (r) (getf r :note)) (people-rows))))
  (is (= 0 (sql "UPDATE people SET note = 'x' WHERE age = 99"))))

(def-test sql-update-reads-the-old-row (:fixture clean-db)
  (make-three-people)
  (sql "UPDATE people SET age = age * 2, note = name")
  (is (equal '(60 50 60) (mapcar (lambda (r) (getf r :age)) (people-rows))))
  (sql "UPDATE people p SET name = p.name || '-' || ? WHERE p.age > ?" "x" 55)
  (is (equal '("ann-x" "bob" "cat-x") (mapcar (lambda (r) (getf r :name)) (people-rows)))))

(def-test sql-update-parameters-keep-text-order (:fixture clean-db)
  (make-three-people)
  (sql "UPDATE people SET age = ?, note = ? WHERE name = ? AND age < ?" 99 "set" "bob" 50)
  (is (equal '(:age 99 :note "set") (let ((r (get-row 2 "people"))) (list :age (getf r :age) :note (getf r :note))))))

(def-test sql-update-errors (:fixture clean-db)
  (make-three-people)
  (signals sql-error (sql "UPDATE people SET nope = 1"))
  (signals sql-error (sql "UPDATE people SET age = nope"))
  (signals sql-error (sql "UPDATE people SET age = 1 WHERE nope = 1"))
  (signals sql-error (sql "UPDATE people age = 1"))
  (signals sql-error (sql "UPDATE people SET age"))
  (signals sql-error (sql "UPDATE people SET"))
  (signals invalid-row (sql "UPDATE people SET id = 9"))
  (signals type-mismatch (sql "UPDATE people SET age = 'old'"))
  (signals check-violation (sql "UPDATE people SET age = -5"))
  (signals unique-violation (sql "UPDATE people SET name = 'ann' WHERE name = 'bob'"))
  (signals schema-error (progn (create-view "v" :from "people") (sql "UPDATE v SET age = 1")))
  (is (equal '(30 25 30) (mapcar (lambda (r) (getf r :age)) (people-rows))) "nothing changed")
  (is (equal '("ann" "bob" "cat") (mapcar (lambda (r) (getf r :name)) (people-rows)))))

(def-test sql-update-is-all-or-nothing (:fixture clean-db)
  (make-three-people)
  (signals unique-violation (sql "UPDATE people SET name = 'same'"))
  (is (equal '("ann" "bob" "cat") (mapcar (lambda (r) (getf r :name)) (people-rows)))))

(def-test sql-update-uses-indexes-and-triggers (:fixture clean-db)
  (make-three-people)
  (make-audit)
  (create-index "people" :age)
  (create-trigger :audit "people" :after :update 'audit-trigger)
  (is (= 2 (sql "UPDATE people SET active = FALSE WHERE age = 30")))
  (is (equal '("update" "update") (audit-whats))))

;;; DELETE

(def-test sql-delete (:fixture clean-db)
  (make-three-people)
  (is (= 2 (sql "DELETE FROM people WHERE age = ?" 30)))
  (is (equal '("bob") (mapcar (lambda (r) (getf r :name)) (people-rows))))
  (is (= 0 (sql "DELETE FROM people WHERE age = 99")))
  (is (= 1 (sql "DELETE FROM people p WHERE p.name = 'bob'")))
  (sql "INSERT INTO people (name) VALUES ('x'), ('y')")
  (is (= 2 (sql "DELETE FROM people")) "no WHERE means every row")
  (is (= 0 (count-rows "people"))))

(def-test sql-delete-follows-the-rules-of-the-tables (:fixture clean-db)
  (make-owner-and-pets :cascade)
  (is (= 1 (sql "DELETE FROM people WHERE id = 1")))
  (is (equal '("kit") (mapcar (lambda (r) (getf r :pet)) (row-list "pets"))))
  (drop-table "pets")
  (make-table "pets" '((:id primary-key-column) (:owner foreign-key-column :references "people") (:pet string)))
  (insert-row '(:owner 2 :pet "kit") "pets")
  (signals foreign-key-violation (sql "DELETE FROM people WHERE id = 2"))
  (is (= 2 (count-rows "people"))))

(def-test sql-delete-errors (:fixture clean-db)
  (make-three-people)
  (signals sql-error (sql "DELETE people"))
  (signals sql-error (sql "DELETE FROM people WHERE nope = 1"))
  (signals sql-error (sql "DELETE FROM"))
  (signals no-such-table (sql "DELETE FROM nope"))
  (signals schema-error (progn (create-view "v" :from "people") (sql "DELETE FROM v")))
  (is (= 3 (count-rows "people"))))

(def-test sql-writes-in-a-user-transaction (:fixture clean-db)
  (make-three-people)
  (with-transaction
    (sql "UPDATE people SET age = 1")
    (sql "DELETE FROM people WHERE name = 'ann'")
    (sql "INSERT INTO people (name) VALUES ('zed')")
    (rollback))
  (is (equal '(30 25 30) (mapcar (lambda (r) (getf r :age)) (people-rows))))
  (is (= 3 (count-rows "people"))))
