;;; explain

(def-test explain-a-full-scan (:fixture clean-db)
  (make-sample-items)
  (is (equal '((:step :scan :table "items" :access :full-scan :rows 7))
             (explain :from "items")))
  (is (equal '((:step :scan :table "items" :access :full-scan :rows 7 :reason :no-index-condition)
               (:step :filter :where (= :qty 1)))
             (explain :from "items" :where '(= :qty 1))))
  (is (equal '((:step :scan :table "items" :access :full-scan :rows 7 :reason :function)
               (:step :filter :where :function))
             (explain :from "items" :where (lambda (r) (declare (ignore r)) t)))))

(def-test explain-an-index-scan-with-exact-rows (:fixture clean-db)
  (make-sample-items)
  (is (equal '((:step :scan :table "items" :access :index :index :cat-index :column :cat
                      :op :eq :rows 2)
               (:step :filter :where (= :cat "toys")))
             (explain :from "items" :where '(= :cat "toys"))))
  (is (equal '(:price-index :range 3)
             (let ((step (first (explain :from "items" :where '(between :price 5 10)))))
               (list (getf (cddr step) :index) (getf (cddr step) :op) (getf (cddr step) :rows)))))
  (is (equal '(:primary-key :eq 1)
             (let ((step (first (explain :from "items" :where '(= :id 2)))))
               (list (getf (cddr step) :index) (getf (cddr step) :op) (getf (cddr step) :rows))))))

(def-test explain-does-not-run-the-query (:fixture clean-db)
  (make-sample-items)
  (let ((calls 0))
    (explain :from "items" :where (lambda (r) (declare (ignore r)) (incf calls) t)
             :order-by (lambda (a b) (declare (ignore a b)) (incf calls) nil))
    (is (= 0 calls)))
  (finishes (explain :from "items" :where '(= :id 1) :group-by :cat :col '(:cat (count))))
  (signals no-such-table (explain :from "nope")))

(def-test explain-joins (:fixture clean-db)
  (make-pet-world)
  (insert-row '(:pet "x") "pets")
  (dotimes (i 40) (insert-row (list :owner 1 :pet "filler") "pets"))
  (let ((steps (explain :from "people" :where '(= :id 1) :inner-join '("pets" :id :owner)
                        :left-join '("toys" :pet-id :pet-ref)
                        :right-join '("people" :id :id :as "p2"))))
    (is (equal '(:inner "pets" :index :owner-fk)
               (let ((step (find :join steps :key #'second)))
                 (list (getf (cddr step) :kind) (getf (cddr step) :table)
                       (getf (cddr step) :method) (getf (cddr step) :index))))
        "one row looks, and pets holds many"))
  (is (equal '(:hash nil)
             (let ((step (find :join (explain :from "people" :right-join '("pets" :id :owner))
                               :key #'second)))
               (list (getf (cddr step) :method) (getf (cddr step) :index))))
      "a right join always builds a hash table")
  (is (equal '(:right-or-full-join)
             (list (getf (cddr (first (explain :from "people" :where '(= :id 1)
                                              :right-join '("pets" :id :owner))))
                         :reason)))))

(def-test explain-lists-the-later-steps-in-order (:fixture clean-db)
  (make-sample-items)
  (is (equal '(:scan :filter :group :sort :project :distinct :limit)
             (mapcar #'second (explain :from "items" :where '(> :qty 1) :group-by :cat
                                       :col '(:cat (as (count) :n)) :order-by '((desc :n))
                                       :distinct t :limit 3 :offset 1))))
  (let ((steps (explain :from "items" :col '(:cat (as (+ :qty 1) :q) (count)) :group-by :cat
                        :having '(> (count) 1) :order-by '((desc :q) :cat) :limit 3)))
    (is (equal '(:cat :q :count) (getf (cddr (find :project steps :key #'second)) :columns)))
    (is (equal '(:by (:cat) :having (> (count) 1))
               (let ((g (cddr (find :group steps :key #'second))))
                 (list :by (getf g :by) :having (getf g :having)))))
    (is (equal '((:key :q :direction :desc :nulls :last) (:key :cat :direction :asc :nulls :last))
               (getf (cddr (find :sort steps :key #'second)) :keys)))
    (is (equal '(:limit 3 :offset nil)
               (let ((l (cddr (find :limit steps :key #'second))))
                 (list :limit (getf l :limit) :offset (getf l :offset)))))))
