(in-package #:hash-db-tests)

(in-suite hash-db-suite)

;;; Helpers

;; An index as plain data: ((key . ids) ...) in key order.
(defun index-contents (index)
  (let ((result '()))
    (fset:do-map (key entry (hash-db::index-map index))
      (push (cons (if (hash-db::skey-p key) (hash-db::skey-string key) key)
                  (if (hash-db::index-unique index) (list entry) (fset:convert 'list entry)))
            result))
    (nreverse result)))

;; True when every index of every table holds exactly what a rebuild would hold.
(defun indexes-match-rows-p (&optional (root (hash-db::current-root)))
  (every (lambda (tbl)
           (every (lambda (index)
                    (equal (index-contents index)
                           (index-contents (hash-db::build-index tbl
                                                                 (hash-db::index-name index)
                                                                 (hash-db::index-column index)
                                                                 (hash-db::index-unique index)
                                                                 (hash-db::index-explicit index)))))
                  (hash-db::indexes tbl)))
         (hash-db::all-tables root)))

(defun index-of (table name)
  (find name (hash-db::indexes (find-table table)) :key #'hash-db::index-name))

(defun index-names (table)
  (mapcar #'hash-db::index-name (hash-db::indexes (find-table table))))

;;; The index structure on its own

(def-test index-finds-ids-by-value (:fixture clean-db)
  (let ((index (hash-db::make-index :n :n nil nil)))
    (setf index (hash-db::index-add index 1 10))
    (setf index (hash-db::index-add index 2 10))
    (setf index (hash-db::index-add index 3 20))
    (setf index (hash-db::index-add index 4 :null))
    (is (equal '(1 2) (hash-db::index-ids index 10)))
    (is (equal '(3) (hash-db::index-ids index 20)))
    (is (equal '() (hash-db::index-ids index 30)))
    (is (equal '() (hash-db::index-ids index :null)) "NULL is not indexed")
    (setf index (hash-db::index-remove index 1 10))
    (is (equal '(2) (hash-db::index-ids index 10)))
    (setf index (hash-db::index-remove index 2 10))
    (is (equal '() (hash-db::index-ids index 10)))
    (is (= 1 (fset:size (hash-db::index-map index))) "an empty entry is dropped")))

(def-test index-treats-equal-numbers-as-one-key (:fixture clean-db)
  (let ((index (hash-db::make-index :n :n nil nil)))
    (setf index (hash-db::index-add index 1 1))
    (setf index (hash-db::index-add index 2 1.0))
    (setf index (hash-db::index-add index 3 2/4))
    (setf index (hash-db::index-add index 4 0.5d0))
    (is (equal '(1 2) (hash-db::index-ids index 1)))
    (is (equal '(3 4) (hash-db::index-ids index 1/2)))
    (is (equal '(3 4) (hash-db::index-ids index 0.5)))))

(def-test unique-index-holds-one-id-per-value (:fixture clean-db)
  (let ((index (hash-db::make-index :u :u t nil)))
    (setf index (hash-db::index-add index 5 "a"))
    (setf index (hash-db::index-add index 6 "b"))
    (is (equal '(5) (hash-db::index-ids index "a")))
    (setf index (hash-db::index-remove index 9 "a"))
    (is (equal '(5) (hash-db::index-ids index "a")) "removing another id changes nothing")
    (setf index (hash-db::index-remove index 5 "a"))
    (is (equal '() (hash-db::index-ids index "a")))))

(def-test range-scan-over-numbers (:fixture clean-db)
  (let ((index (hash-db::make-index :n :n nil nil)))
    (loop for (id value) in '((1 5) (2 1/2) (3 3) (4 10) (5 3) (6 -4) (7 2.5))
          do (setf index (hash-db::index-add index id value)))
    (flet ((range (&rest args) (apply #'hash-db::index-range-ids index args)))
      (is (equal '(6 2 7 3 5 1 4) (range nil nil nil nil)) "in value order, ties in id order")
      (is (equal '(3 5 1) (range 3 t 5 t)))
      (is (equal '(1) (range 3 nil 5 t)))
      (is (equal '(3 5) (range 3 t 5 nil)))
      (is (equal '(7) (range 2 nil 3 nil)))
      (is (equal '(1 4) (range 5 t nil nil)))
      (is (equal '(6 2) (range nil nil 1 nil)))
      (is (equal '() (range 100 t nil nil)))
      (is (equal '() (range 4 t 4 t)))
      (is (equal '(3 5) (range 3 t 3 t)))
      (is (equal '() (range 5 t 3 t)) "an empty range"))))

(def-test range-scan-over-strings-uses-string-order (:fixture clean-db)
  (let ((index (hash-db::make-index :s :s nil nil)))
    (loop for (id value) in '((1 "b") (2 "a") (3 "B") (4 "ab") (5 "") (6 "z"))
          do (setf index (hash-db::index-add index id value)))
    (is (equal '(5 3 2 4 1 6) (hash-db::index-range-ids index nil nil nil nil))
        "by character code, not by length: \"ab\" comes before \"b\"")
    (is (equal '(2 4 1) (hash-db::index-range-ids index "a" t "b" t)))
    (is (equal '(4) (hash-db::index-range-ids index "a" nil "b" nil)))))

;;; Implicit indexes

(def-test unique-and-foreign-key-columns-get-indexes (:fixture clean-db)
  (make-people)
  (make-table "u" '((:id primary-key-column) (:e string :unique t) (:n number)))
  (make-pets)
  (is (equal '() (index-names "people")))
  (is (equal '(:e-unique) (index-names "u")))
  (is (equal '(:owner-fk) (index-names "pets")))
  (is (hash-db::index-unique (index-of "u" :e-unique)))
  (is (not (hash-db::index-unique (index-of "pets" :owner-fk)))))

(def-test indexes-follow-the-rows (:fixture clean-db)
  (make-table "u" '((:id primary-key-column) (:e string :unique t) (:n number)))
  (insert-row '(:e "a" :n 1) "u")
  (insert-row '(:e "b" :n 2) "u")
  (insert-row '(:n 3) "u")
  (is (equal '(("a" 1) ("b" 2)) (index-contents (index-of "u" :e-unique))))
  (update-row 1 '(:e "c") "u")
  (is (equal '(("b" 2) ("c" 1)) (index-contents (index-of "u" :e-unique))))
  (update-row 3 '(:e "a") "u")
  (update-row 2 '(:e :null) "u")
  (is (equal '(("a" 3) ("c" 1)) (index-contents (index-of "u" :e-unique))))
  (delete-row 1 "u")
  (is (equal '(("a" 3)) (index-contents (index-of "u" :e-unique))))
  (is (indexes-match-rows-p)))

(def-test unique-check-uses-the-index (:fixture clean-db)
  (make-table "u" '((:id primary-key-column) (:e string :unique t)))
  (insert-row '(:e "a") "u")
  (signals unique-violation (insert-row '(:e "a") "u"))
  (insert-row '(:e "b") "u")
  (signals unique-violation (update-row 2 '(:e "a") "u"))
  (finishes (update-row 2 '(:e "b") "u") "a row does not clash with itself")
  (is (indexes-match-rows-p)))

(def-test unique-check-treats-equal-numbers-as-equal (:fixture clean-db)
  (make-table "u" '((:id primary-key-column) (:n number :unique t)))
  (insert-row '(:n 1) "u")
  (signals unique-violation (insert-row '(:n 1.0) "u"))
  (signals unique-violation (insert-row '(:n 2/2) "u")))

(def-test add-column-builds-an-index-for-a-unique-column (:fixture clean-db)
  (make-table "t" '((:id primary-key-column)))
  (insert-row '() "t")
  (insert-row '() "t")
  (add-column (find-table "t") '(:code integer :unique t))
  (is (equal '(:code-unique) (index-names "t")))
  (is (equal '() (index-contents (index-of "t" :code-unique))) "NULLs are not indexed")
  (insert-row '(:code 5) "t")
  (signals unique-violation (insert-row '(:code 5) "t"))
  (is (indexes-match-rows-p)))

(def-test indexes-follow-a-rolled-back-transaction (:fixture clean-db)
  (make-table "u" '((:id primary-key-column) (:e string :unique t)))
  (insert-row '(:e "a") "u")
  (with-transaction (insert-row '(:e "b") "u") (delete-row 1 "u") (rollback))
  (is (equal '(("a" 1)) (index-contents (index-of "u" :e-unique))))
  (finishes (insert-row '(:e "b") "u")))

(def-test cascade-finds-children-through-the-index (:fixture clean-db)
  (make-owner-and-pets :cascade)
  (delete-row 1 "people")
  (is (equal '("kit") (mapcar (lambda (r) (getf r :pet)) (row-list "pets"))))
  (is (indexes-match-rows-p))
  (make-owner-and-pets-again-for-restrict))

(defun make-owner-and-pets-again-for-restrict ()
  (drop-table "pets")
  (make-table "pets" '((:id primary-key-column)
                       (:owner foreign-key-column :references "people")
                       (:pet string)))
  (insert-row '(:owner 2 :pet "kit") "pets")
  (signals foreign-key-violation (delete-row 2 "people")))

;;; Indexes after a restart

(def-test indexes-are-rebuilt-after-load (:fixture clean-db)
  (make-table "u" '((:id primary-key-column) (:e string :unique t)))
  (make-pets)
  (insert-row '(:e "a") "u")
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (load-db path)))
  (is (equal '(("a" 1)) (index-contents (index-of "u" :e-unique))))
  (signals unique-violation (insert-row '(:e "a") "u"))
  (is (equal '(:owner-fk) (index-names "pets")))
  (is (indexes-match-rows-p)))

(def-test indexes-are-rebuilt-after-log-replay (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (make-table "u" '((:id primary-key-column) (:e string :unique t)))
      (insert-row '(:e "a") "u")
      (insert-row '(:e "b") "u")
      (update-row 1 '(:e "c") "u")
      (delete-row 2 "u")
      (add-column (find-table "u") '(:code integer :unique t))
      (restart-db path)
      (is (equal '(("c" 1)) (index-contents (index-of "u" :e-unique))))
      (is (equal '(:e-unique :code-unique) (index-names "u")))
      (signals unique-violation (insert-row '(:e "c") "u"))
      (is (indexes-match-rows-p)))))

;;; Random work keeps every index in step with its rows

(def-test indexes-match-rows-after-random-work (:fixture clean-db)
  (make-table "p" '((:id primary-key-column) (:name string :unique t) (:n integer)))
  (make-table "c" (list '(:id primary-key-column)
                        (list :parent 'foreign-key-column :references "p" :on-delete :cascade)
                        (list :other 'foreign-key-column :references "p" :on-delete :set-null)
                        '(:code integer :unique t)))
  (let ((rs (sb-ext:seed-random-state 20261110)))
    (dotimes (step 600)
      (let ((names (list "a" "b" "c" "d" "e" "f")))
        (ignore-errors
         (with-transaction
           (dotimes (k (1+ (random 3 rs)))
             (ecase (random 8 rs)
               (0 (insert-row (list :name (nth (random 6 rs) names) :n (random 5 rs)) "p"))
               (1 (insert-row (list :parent (1+ (random 12 rs)) :other (1+ (random 12 rs))
                                    :code (random 30 rs))
                              "c"))
               (2 (update-row (1+ (random 12 rs)) (list :name (nth (random 6 rs) names)) "p"))
               (3 (update-row (1+ (random 12 rs)) (list :parent (1+ (random 12 rs))
                                                        :code (random 30 rs))
                              "c"))
               (4 (delete-row (1+ (random 12 rs)) "p"))
               (5 (delete-row (1+ (random 12 rs)) "c"))
               (6 (update-where "c" nil :where t :compute '(:code (+ :code 1))))
               (7 (when (zerop (random 3 rs)) (rollback)))))))
        (when (zerop (mod step 50))
          (is (indexes-match-rows-p) "indexes match rows at step ~D" step))))
    (is (indexes-match-rows-p))
    (is (plusp (count-rows "p")) "the random work left something to check")))

;;; create-index, drop-index and show-indexes

(def-test create-index-and-show-indexes (:fixture clean-db)
  (make-people)
  (add-people)
  (is (eq :age-index (create-index "people" :age)))
  (is (eq :by-name (create-index "people" :name :name :by-name)))
  (is (equal '((:name :age-index :column :age :unique nil :explicit t)
               (:name :by-name :column :name :unique nil :explicit t))
             (show-indexes "people")))
  (is (equal '(("bob" 2)) (remove-if-not (lambda (e) (equal (first e) "bob"))
                                         (index-contents (index-of "people" :by-name)))))
  (is (equal '((25 2) (30 1 3)) (mapcar (lambda (e) (cons (car e) (cdr e)))
                                        (index-contents (index-of "people" :age-index)))))
  (insert-row '(:name "dan" :age 25) "people")
  (is (equal '(2 4) (hash-db::index-ids (index-of "people" :age-index) 25)))
  (is (indexes-match-rows-p)))

(def-test show-indexes-lists-implicit-indexes-too (:fixture clean-db)
  (make-table "u" '((:id primary-key-column) (:e string :unique t)))
  (is (equal '((:name :e-unique :column :e :unique t :explicit nil)) (show-indexes "u"))))

(def-test unique-index-is-enforced (:fixture clean-db)
  (make-people)
  (add-people)
  (create-index "people" :name :unique t :name :unique-name)
  (signals unique-violation (insert-row '(:name "ann") "people"))
  (signals unique-violation (update-row 2 '(:name "cat") "people"))
  (finishes (insert-row '(:name "zed") "people"))
  (finishes (update-row 2 '(:name "bob" :age 26) "people"))
  (insert-row '() "people")
  (finishes (insert-row '() "people") "many NULLs are fine")
  (is (indexes-match-rows-p)))

(def-test creating-a-unique-index-on-duplicates-fails-and-changes-nothing (:fixture clean-db)
  (make-people)
  (add-people)
  (signals unique-violation (create-index "people" :age :unique t))
  (is (equal '() (show-indexes "people")))
  (finishes (create-index "people" :age)))

(def-test bad-index-requests (:fixture clean-db)
  (make-people)
  (make-table "u" '((:id primary-key-column) (:e string :unique t)))
  (make-pets)
  (signals schema-error (create-index "people" :id))
  (signals no-such-column (create-index "people" :nope))
  (signals no-such-table (create-index "nope" :age))
  (create-index "people" :age)
  (signals schema-error (create-index "people" :age) "same column, same kind")
  (signals schema-error (create-index "people" :name :name :age-index) "name in use")
  (signals schema-error (create-index "u" :e :unique t) "the :unique column has one already")
  (signals schema-error (create-index "pets" :owner) "the foreign key has one already")
  (finishes (create-index "people" :active :unique nil :name :fresh)))

(def-test drop-index (:fixture clean-db)
  (make-people)
  (make-table "u" '((:id primary-key-column) (:e string :unique t)))
  (add-people)
  (create-index "people" :name :unique t)
  (signals unique-violation (insert-row '(:name "ann") "people"))
  (is-true (drop-index :name-index "people"))
  (finishes (insert-row '(:name "ann") "people") "no longer unique")
  (is-false (drop-index :name-index "people") "already gone")
  (signals schema-error (drop-index :e-unique "u") "implicit indexes stay")
  (signals no-such-table (drop-index :x "nope")))

(def-test index-changes-roll-back (:fixture clean-db)
  (make-people)
  (add-people)
  (with-transaction (create-index "people" :age) (rollback))
  (is (equal '() (show-indexes "people")))
  (create-index "people" :age)
  (with-transaction (drop-index :age-index "people") (rollback))
  (is (= 1 (length (show-indexes "people")))))

;;; Explicit indexes survive files and the log

(def-test explicit-indexes-survive-save-and-load (:fixture clean-db)
  (make-people)
  (add-people)
  (create-index "people" :age)
  (create-index "people" :name :unique t :name :uniq)
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (load-db path)))
  (is (equal '(:age-index :uniq) (index-names "people")))
  (signals unique-violation (insert-row '(:name "ann") "people"))
  (is (equal '(1 3) (hash-db::index-ids (index-of "people" :age-index) 30)))
  (is (indexes-match-rows-p)))

(def-test explicit-indexes-survive-the-log-and-checkpoints (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (make-people)
      (add-people)
      (create-index "people" :age)
      (create-index "people" :name :unique t :name :uniq)
      (drop-index :age-index "people")
      (create-index "people" :active :name :act)
      (restart-db path)
      (is (equal '(:uniq :act) (index-names "people")) "replayed from the log")
      (signals unique-violation (insert-row '(:name "ann") "people"))
      (checkpoint)
      (restart-db path)
      (is (equal '(:uniq :act) (index-names "people")) "read from the snapshot")
      (is (indexes-match-rows-p)))))

(def-test version-3-files-still-load (:fixture clean-db)
  (call-with-temp-file
    (lambda (path)
      (cl-store:store (list :hash-db 3 0
                            (list (list "t" 2 '((:id primary-key-column) (:e string :unique t))
                                        '((1 :id 1 :e "a") (2 :id 2 :e "b")))))
                      path)
      (load-db path)))
  (is (equal '(:e-unique) (index-names "t")))
  (signals unique-violation (insert-row '(:e "a") "t")))
