(in-package #:hash-db-tests)

(in-suite hash-db-suite)

(defun column-summary (table)
  (mapcar (lambda (c) (list (name c) (second (hash-db::spec c)))) (schema (find-table table))))

;;; CREATE TABLE

(def-test sql-create-table-types (:fixture clean-db)
  (is (equal "t" (sql "CREATE TABLE t (
                         id INTEGER PRIMARY KEY,
                         a INT, b BIGINT, c SMALLINT,
                         d REAL, e FLOAT, f DOUBLE PRECISION,
                         g NUMERIC(10, 2), h DECIMAL,
                         i TEXT, j VARCHAR(255), k CHAR(3), l CHARACTER VARYING(10),
                         m BOOLEAN, n BOOL, o TIMESTAMP, p JSON, q JSONB)")))
  (is (equal '((:id primary-key-column) (:a integer) (:b integer) (:c integer)
               (:d float) (:e float) (:f float) (:g number) (:h number)
               (:i string) (:j string) (:k string) (:l string)
               (:m boolean) (:n boolean) (:o timestamp) (:p json) (:q json))
             (column-summary "t"))))

(def-test sql-create-table-constraints (:fixture clean-db)
  (sql "CREATE TABLE people (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          name TEXT NOT NULL UNIQUE,
          age INTEGER CHECK (age >= 0 AND age < 150) DEFAULT 18,
          active BOOLEAN DEFAULT TRUE,
          note TEXT DEFAULT 'none' NULL,
          at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
          rank INTEGER DEFAULT -1)")
  (with-clock (700)
    (sql "INSERT INTO people (name) VALUES ('ann')"))
  (is (equal '((:id 1 :name "ann" :age 18 :active t :note "none" :at 700 :rank -1)) (row-list "people")))
  (signals unique-violation (sql "INSERT INTO people (name) VALUES ('ann')"))
  (signals not-null-violation (sql "INSERT INTO people (age) VALUES (3)"))
  (signals check-violation (sql "INSERT INTO people (name, age) VALUES ('x', 150)"))
  (signals check-violation (sql "INSERT INTO people (name, age) VALUES ('y', -1)"))
  (is (equal '(:name-unique) (index-names "people"))))

(def-test sql-create-table-foreign-keys (:fixture clean-db)
  (sql "CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT)")
  (sql "CREATE TABLE pets (id INTEGER PRIMARY KEY,
                           owner INTEGER REFERENCES people(id) ON DELETE CASCADE,
                           pet TEXT)")
  (sql "CREATE TABLE toys (id INTEGER PRIMARY KEY, pet INTEGER, FOREIGN KEY (pet) REFERENCES pets ON DELETE SET NULL)")
  (sql "INSERT INTO people (name) VALUES ('ann')")
  (sql "INSERT INTO pets (owner, pet) VALUES (1, 'rex')")
  (sql "INSERT INTO toys (pet) VALUES (1)")
  (signals foreign-key-violation (sql "INSERT INTO pets (owner, pet) VALUES (99, 'x')"))
  (is (eq :null (progn (sql "DELETE FROM pets") (getf (get-row 1 "toys") :pet))) "SET NULL")
  (sql "INSERT INTO pets (owner, pet) VALUES (1, 'tom')")
  (sql "DELETE FROM people")
  (is (= 0 (count-rows "pets")) "CASCADE")
  (sql "CREATE TABLE kids (id INTEGER PRIMARY KEY, p INTEGER REFERENCES people)")
  (sql "INSERT INTO people (name) VALUES ('bob')")
  (sql "INSERT INTO kids (p) VALUES (2)")
  (signals foreign-key-violation (sql "DELETE FROM people") "the default is RESTRICT"))

(def-test sql-create-table-self-reference (:fixture clean-db)
  (sql "CREATE TABLE nodes (id INTEGER PRIMARY KEY, parent INTEGER REFERENCES nodes(id) ON DELETE CASCADE)")
  (sql "INSERT INTO nodes (parent) VALUES (NULL)")
  (sql "INSERT INTO nodes (parent) VALUES (1)")
  (is (= 1 (sql "DELETE FROM nodes WHERE id = 1")))
  (is (= 0 (count-rows "nodes"))))

(def-test sql-create-table-constraints-of-the-table (:fixture clean-db)
  (sql "CREATE TABLE people (id INTEGER, name TEXT, age INTEGER, boss INTEGER,
                             PRIMARY KEY (id), UNIQUE (name), CHECK (age > 0),
                             FOREIGN KEY (boss) REFERENCES people (id))")
  (is (equal '((:id primary-key-column) (:name string) (:age integer) (:boss foreign-key-column))
             (column-summary "people")))
  (sql "INSERT INTO people (name, age) VALUES ('ann', 5)")
  (signals unique-violation (sql "INSERT INTO people (name, age) VALUES ('ann', 5)"))
  (signals check-violation (sql "INSERT INTO people (name, age) VALUES ('bob', 0)"))
  (signals foreign-key-violation (sql "INSERT INTO people (name, boss) VALUES ('cat', 99)")))

(def-test sql-create-table-two-checks-on-a-column (:fixture clean-db)
  (sql "CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER CHECK (n > 0), CHECK (n < 10))")
  (finishes (sql "INSERT INTO t (n) VALUES (5)"))
  (signals check-violation (sql "INSERT INTO t (n) VALUES (0)"))
  (signals check-violation (sql "INSERT INTO t (n) VALUES (10)")))

(def-test sql-created-tables-survive-save-and-restart (:fixture clean-db)
  (sql "CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, age INTEGER CHECK (age >= 0) DEFAULT 1)")
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (load-db path)))
  (signals check-violation (sql "INSERT INTO people (name, age) VALUES ('a', -1)"))
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (clear-db)
      (open-db path)
      (sql "CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, age INTEGER CHECK (age >= 0) DEFAULT 1)")
      (sql "INSERT INTO people (name) VALUES ('a')")
      (restart-db path)
      (signals check-violation (sql "INSERT INTO people (name, age) VALUES ('b', -1)"))
      (signals unique-violation (sql "INSERT INTO people (name) VALUES ('a')"))
      (is (= 1 (getf (get-row 1 "people") :age)))
      (checkpoint)
      (restart-db path)
      (signals check-violation (sql "INSERT INTO people (name, age) VALUES ('b', -1)")))))

(def-test sql-create-table-names (:fixture clean-db)
  (sql "CREATE TABLE People (Id INTEGER PRIMARY KEY, Name TEXT)")
  (is (equal '("people") (show-tables)) "an unquoted name is read in lower case")
  (sql "CREATE TABLE \"Mixed Case\" (id INTEGER PRIMARY KEY)")
  (is (member "Mixed Case" (show-tables) :test #'equal))
  (is (null (sql "CREATE TABLE IF NOT EXISTS people (x INTEGER)"))))

(def-test sql-create-if-not-exists (:fixture clean-db)
  (sql "CREATE TABLE t (id INTEGER PRIMARY KEY)")
  (is (null (sql "CREATE TABLE IF NOT EXISTS t (x TEXT)")))
  (is (equal '((:id primary-key-column)) (column-summary "t")) "the old table is untouched")
  (signals table-exists (sql "CREATE TABLE t (x TEXT)")))

(def-test sql-create-table-errors (:fixture clean-db)
  (sql "CREATE TABLE people (id INTEGER PRIMARY KEY)")
  (flet ((fails (text)
           (handler-case (progn (sql text) nil)
             (sql-error (c) (error-message c)))))
    (is (search "not supported. Supported:" (fails "CREATE TABLE t (a BLOB)")))
    (is (search "not supported. Supported:" (fails "CREATE TABLE t (a INTERVAL)")))
    (is (search "PRIMARY KEY must be an INTEGER" (fails "CREATE TABLE t (a TEXT PRIMARY KEY)")))
    (is (search "one primary key" (fails "CREATE TABLE t (a INTEGER PRIMARY KEY, b INTEGER PRIMARY KEY)")))
    (is (search "no DEFAULT" (fails "CREATE TABLE t (a INTEGER PRIMARY KEY DEFAULT 5)")))
    (is (search "must be an integer column" (fails "CREATE TABLE t (a TEXT REFERENCES people)")))
    (is (search "refers to the primary key" (fails "CREATE TABLE t (a INTEGER REFERENCES people(name))")))
    (sql "CREATE TABLE np (x INTEGER)")
    (is (search "no primary key" (fails "CREATE TABLE t (a INTEGER REFERENCES np)")))
    (is (search "of several columns" (fails "CREATE TABLE t (a INTEGER, b INTEGER, PRIMARY KEY (a, b))")))
    (is (search "of several columns" (fails "CREATE TABLE t (a INTEGER, b INTEGER, UNIQUE (a, b))")))
    (is (search "can name one column" (fails "CREATE TABLE t (a INTEGER, b INTEGER, CHECK (a < b))")))
    (is (search "can name one column" (fails "CREATE TABLE t (a INTEGER, CHECK (1 = 1))")))
    (is (search "Named constraints" (fails "CREATE TABLE t (a INTEGER CONSTRAINT x UNIQUE)")))
    (is (search "ON UPDATE" (fails "CREATE TABLE t (a INTEGER REFERENCES people ON UPDATE CASCADE)")))
    (is (search "no column zzz" (fails "CREATE TABLE t (a INTEGER, UNIQUE (zzz))")))
    (is (search "Expected a column type" (fails "CREATE TABLE t (a)")))
    (is (search "Expected TABLE, INDEX, VIEW or SEQUENCE" (fails "CREATE FROBNICATE x")))
    (signals no-such-table (sql "CREATE TABLE t (a INTEGER REFERENCES nowhere)"))
    (signals schema-error (sql "CREATE TABLE t (a INTEGER, a TEXT)"))
    (is (search "Unknown column b" (fails "CREATE TABLE t (a INTEGER CHECK (b > 0))")))
    (is (equal '("np" "people") (sort (show-tables) #'string<)) "nothing was made")))

;;; CREATE INDEX, VIEW, SEQUENCE

(def-test sql-create-and-drop-index (:fixture clean-db)
  (sql "CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")
  (is (eq :age-index (sql "CREATE INDEX ON people (age)")))
  (is (eq :by_name (sql "CREATE UNIQUE INDEX by_name ON people (name)")))
  (is (equal '(:age-index :by_name) (index-names "people")))
  (sql "INSERT INTO people (name, age) VALUES ('ann', 30)")
  (signals unique-violation (sql "INSERT INTO people (name, age) VALUES ('ann', 31)"))
  (is (null (sql "CREATE INDEX IF NOT EXISTS by_name ON people (name)")))
  (signals schema-error (sql "CREATE INDEX by_name ON people (age)"))
  (signals sql-error (sql "CREATE INDEX x ON people (nope)"))
  (signals sql-error (sql "CREATE INDEX x ON people (age, name)"))
  (is-true (sql "DROP INDEX by_name"))
  (is-true (sql "DROP INDEX age_index ON people") "an underscore finds the name AGE-INDEX")
  (is (null (index-names "people"))))

(def-test sql-drop-index-rules (:fixture clean-db)
  (sql "CREATE TABLE a (id INTEGER PRIMARY KEY, x INTEGER)")
  (sql "CREATE TABLE b (id INTEGER PRIMARY KEY, x INTEGER)")
  (sql "CREATE INDEX same ON a (x)")
  (sql "CREATE INDEX same ON b (x)")
  (signals sql-error (sql "DROP INDEX same") "two tables have it")
  (is-true (sql "DROP INDEX same ON a"))
  (is-true (sql "DROP INDEX same"))
  (signals sql-error (sql "DROP INDEX same"))
  (is (null (sql "DROP INDEX IF EXISTS same"))))

(def-test sql-create-view (:fixture clean-db)
  (sql "CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")
  (sql "INSERT INTO people (name, age) VALUES ('ann', 30), ('bob', 20)")
  (sql "CREATE VIEW adults AS SELECT id, name FROM people WHERE age >= 21 ORDER BY id")
  (is (equal '((:id 1 :name "ann")) (q "SELECT * FROM adults")))
  (sql "INSERT INTO people (name, age) VALUES ('cat', 40)")
  (is (equal '("ann" "cat") (mapcar (lambda (r) (getf r :name)) (q "SELECT name FROM adults"))) "it follows the data")
  (is (null (sql "CREATE VIEW IF NOT EXISTS adults AS SELECT id FROM people")))
  (signals schema-error (sql "CREATE VIEW adults AS SELECT id FROM people"))
  (signals sql-error (sql "CREATE VIEW v AS SELECT id FROM people WHERE age > ?" 5))
  (signals sql-error (sql "CREATE VIEW v AS SELECT nope FROM people"))
  (is (equal "adults" (getf (first (show-views)) :name)))
  (is-true (sql "DROP VIEW adults"))
  (signals sql-error (sql "DROP VIEW adults"))
  (is (null (sql "DROP VIEW IF EXISTS adults"))))

(def-test sql-create-sequence (:fixture clean-db)
  (is (equal "n" (sql "CREATE SEQUENCE n")))
  (is (= 1 (next-value "n")))
  (sql "CREATE SEQUENCE orders START WITH 1000 INCREMENT BY 5")
  (sql "CREATE SEQUENCE down INCREMENT -2 START 10")
  (is (equal '(1000 1005) (list (next-value "orders") (next-value "orders"))))
  (is (equal '(10 8) (list (next-value "down") (next-value "down"))))
  (is (null (sql "CREATE SEQUENCE IF NOT EXISTS n")))
  (signals schema-error (sql "CREATE SEQUENCE n"))
  (signals sql-error (sql "CREATE SEQUENCE bad START 1.5"))
  (is-true (sql "DROP SEQUENCE n"))
  (signals no-such-sequence (sql "DROP SEQUENCE n"))
  (is (null (sql "DROP SEQUENCE IF EXISTS n"))))

;;; DROP TABLE and ALTER TABLE

(def-test sql-drop-table (:fixture clean-db)
  (sql "CREATE TABLE a (id INTEGER PRIMARY KEY)")
  (sql "CREATE TABLE b (id INTEGER PRIMARY KEY, a INTEGER REFERENCES a)")
  (signals schema-error (sql "DROP TABLE a") "b refers to it")
  (is-true (sql "DROP TABLE b"))
  (is-true (sql "DROP TABLE a"))
  (signals no-such-table (sql "DROP TABLE a"))
  (is (null (sql "DROP TABLE IF EXISTS a"))))

(def-test sql-alter-table (:fixture clean-db)
  (sql "CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)")
  (sql "INSERT INTO people (name, age) VALUES ('ann', 30)")
  (is (eq :email (sql "ALTER TABLE people ADD COLUMN email TEXT DEFAULT 'none' NOT NULL UNIQUE")))
  (is (equal "none" (getf (get-row 1 "people") :email)))
  (sql "ALTER TABLE people ADD note TEXT CHECK (length(note) < 5)")
  (signals check-violation (sql "INSERT INTO people (name, note) VALUES ('x', 'too long')"))
  (sql "ALTER TABLE people RENAME COLUMN email TO mail")
  (is (equal "none" (getf (get-row 1 "people") :mail)))
  (sql "ALTER TABLE people RENAME note TO memo")
  (sql "ALTER TABLE people DROP COLUMN memo")
  (sql "ALTER TABLE people DROP age")
  (is (equal '(:id :name :mail) (mapcar #'name (schema (find-table "people")))))
  (sql "ALTER TABLE people RENAME TO humans")
  (is (equal '("humans") (show-tables)))
  (is (equal '((:id 1 :name "ann" :mail "none")) (q "SELECT * FROM humans"))))

(def-test sql-alter-table-errors (:fixture clean-db)
  (sql "CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT)")
  (flet ((fails (text)
           (handler-case (progn (sql text) nil)
             (sql-error (c) (error-message c)))))
    (is (search "constraint is not supported" (fails "ALTER TABLE people ADD CONSTRAINT x UNIQUE (name)")))
    (is (search "constraint is not supported" (fails "ALTER TABLE people ADD UNIQUE (name)")))
    (is (search "Expected ADD, DROP or RENAME" (fails "ALTER TABLE people SET x")))
    (is (search "can not be added" (fails "ALTER TABLE people ADD COLUMN k INTEGER PRIMARY KEY")))
    (is (search "has no column nope" (fails "ALTER TABLE people DROP COLUMN nope")))
    (signals schema-error (sql "ALTER TABLE people DROP COLUMN id"))
    (signals schema-error (sql "ALTER TABLE people ADD COLUMN name TEXT"))
    (signals no-such-table (sql "ALTER TABLE nope ADD COLUMN x TEXT"))
    (signals schema-error (progn (create-view "v" :from "people") (sql "ALTER TABLE v ADD COLUMN x TEXT")))))

(def-test sql-ddl-in-a-transaction-rolls-back (:fixture clean-db)
  (with-transaction
    (sql "CREATE TABLE t (id INTEGER PRIMARY KEY, x INTEGER)")
    (sql "CREATE INDEX ON t (x)")
    (rollback))
  (is (null (show-tables))))
