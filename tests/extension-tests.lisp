(in-package #:hash-db-tests)

(in-suite hash-db-suite)

;;; A toy feature that uses the extension points: named notes in the root.
;;; A note is the list (:note text). Notes share the namespace with tables.

(defun note (name)
  (let ((object (values (fset:lookup (hash-db::current-root) name))))
    (and (consp object) (eq (first object) :note) (second object))))

(defun put-note (name text)
  (with-transaction
    (setf (hash-db::txn-root hash-db::*txn*)
          (fset:with (hash-db::txn-root hash-db::*txn*) name (list :note text)))
    (hash-db::journal-add (list :test-note name text))
    text))

(hash-db::define-replay :test-note (root name text)
  (fset:with root name (list :note text)))

(hash-db::register-snapshot-section
 :test-notes
 (lambda (root)
   (loop for name in (fset:convert 'list (fset:domain root))
         for object = (values (fset:lookup root name))
         when (and (consp object) (eq (first object) :note))
           collect (list name (second object))))
 (lambda (root data)
   (loop for (name text) in data
         do (setf root (fset:with root name (list :note text))))
   root))

(hash-db::register-save-check
 (lambda (root)
   (fset:do-map (name object root)
     (when (and (consp object) (eq (first object) :note) (equal (second object) "unsavable"))
       (error 'persistence-error :message (format nil "Note ~A can't be saved" name))))))

(def-test other-things-in-the-root-are-not-tables (:fixture clean-db)
  (make-people)
  (put-note "memo" "hello")
  (is (equal '("people") (show-tables)))
  (is (equal "hello" (note "memo")))
  (signals no-such-table (find-table "memo"))
  (signals no-such-table (insert-row '(:name "x") "memo"))
  (is-false (drop-table "memo") "drop-table only drops tables")
  (signals table-exists (make-table "memo" '((:a number))))
  (is (indexes-match-rows-p)))

(def-test extension-entries-replay-from-the-log (:fixture clean-db)
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (make-people)
      (put-note "memo" "from the log")
      (restart-db path)
      (is (equal "from the log" (note "memo")))
      (is (equal '("people") (show-tables))))))

(def-test extension-sections-survive-snapshots (:fixture clean-db)
  (make-people)
  (put-note "memo" "in a snapshot")
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (is (null (note "memo")))
      (load-db path)))
  (is (equal "in a snapshot" (note "memo")))
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (open-db path)
      (put-note "other" "checkpointed")
      (checkpoint)
      (restart-db path)
      (is (equal "checkpointed" (note "other"))))))

(def-test save-checks-can-refuse-a-save (:fixture clean-db)
  (put-note "bad" "unsavable")
  (call-with-temp-file
    (lambda (path)
      (signals persistence-error (save-db path))
      (is (null (probe-file path))))))

(def-test unknown-log-entries-are-an-error (:fixture clean-db)
  (signals persistence-error (hash-db::replay-entries (fset:empty-map) '((:no-such-kind 1)))))

(def-test version-4-files-still-load (:fixture clean-db)
  (call-with-temp-file
    (lambda (path)
      (cl-store:store (list :hash-db 4 0
                            (list (list "t" 1 '((:id primary-key-column) (:e string)) '((1 :id 1 :e "a"))
                                        '((:by-e :e nil)))))
                      path)
      (load-db path)))
  (is (equal '(:by-e) (index-names "t"))))

;;; Sequences

(def-test sequence-counts (:fixture clean-db)
  (create-sequence "n")
  (is (null (current-value "n")))
  (is (= 1 (next-value "n")))
  (is (= 2 (next-value "n")))
  (is (= 2 (current-value "n")))
  (create-sequence "evens" :start 10 :increment 2)
  (is (equal '(10 12 14) (list (next-value "evens") (next-value "evens") (next-value "evens"))))
  (create-sequence "down" :start 0 :increment -5)
  (is (equal '(0 -5 -10) (list (next-value "down") (next-value "down") (next-value "down"))))
  (is (= -10 (current-value "down"))))

(def-test sequence-restart-drop-and-show (:fixture clean-db)
  (create-sequence "n" :start 5)
  (next-value "n")
  (is (equal '((:name "n" :next 6 :increment 1 :issued t)) (show-sequences)))
  (restart-sequence "n" 100)
  (is (null (current-value "n")))
  (is (= 100 (next-value "n")))
  (is-true (drop-sequence "n"))
  (is-false (drop-sequence "n"))
  (is (null (show-sequences)))
  (signals no-such-sequence (next-value "n"))
  (signals no-such-sequence (current-value "n")))

(def-test sequence-errors (:fixture clean-db)
  (make-people)
  (create-sequence "n")
  (signals schema-error (create-sequence "n"))
  (signals schema-error (create-sequence "people"))
  (signals table-exists (make-table "n" '((:a number))))
  (signals schema-error (create-sequence "z" :increment 0))
  (signals schema-error (create-sequence "z" :start 1.5))
  (signals schema-error (restart-sequence "n" "x"))
  (is (equal '("people") (show-tables)) "a sequence is not a table"))

(def-test sequence-follows-transactions (:fixture clean-db)
  (create-sequence "n")
  (with-transaction (next-value "n") (next-value "n") (rollback))
  (is (= 1 (next-value "n")) "a rolled back number is given again")
  (ignore-errors (with-transaction (next-value "n") (error "boom")))
  (is (= 2 (next-value "n")))
  (with-transaction
    (is (= 3 (next-value "n")))
    (with-transaction (next-value "n") (rollback))
    (is (= 4 (next-value "n")))))

(defun next-order-number () (next-value "order-numbers"))

(def-test sequence-as-a-column-default (:fixture clean-db)
  (create-sequence "order-numbers" :start 1000)
  (make-table "orders" '((:id primary-key-column) (:no integer :default-fn next-order-number)))
  (insert-row '() "orders")
  (insert-row '() "orders")
  (insert-row '(:no 5) "orders")
  (ignore-errors (insert-row '(:no "x") "orders"))
  (insert-row '() "orders")
  (is (equal '(1000 1001 5 1002) (mapcar (lambda (r) (getf r :no)) (row-list "orders")))))

(def-test sequence-gives-unique-numbers-to-parallel-threads (:fixture clean-db)
  (create-sequence "n")
  (let* ((threads (loop repeat 4
                        collect (bt:make-thread
                                  (lambda () (loop repeat 50 collect (next-value "n"))))))
         (numbers (apply #'append (mapcar #'bt:join-thread threads))))
    (is (= 200 (length (remove-duplicates numbers))))
    (is (equal (loop for i from 1 to 200 collect i) (sort (copy-list numbers) #'<)))))

(def-test sequence-survives-snapshot-log-and-checkpoint (:fixture clean-db)
  (create-sequence "n" :start 10 :increment 5)
  (next-value "n")
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (load-db path)))
  (is (= 10 (current-value "n")))
  (is (= 15 (next-value "n")))
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (clear-db)
      (open-db path)
      (create-sequence "s" :start 3)
      (next-value "s")
      (next-value "s")
      (restart-db path)
      (is (= 4 (current-value "s")) "from the log")
      (is (= 5 (next-value "s")))
      (checkpoint)
      (restart-db path)
      (is (= 5 (current-value "s")) "from the snapshot")
      (create-sequence "t")
      (restart-sequence "t" 50)
      (drop-sequence "s")
      (restart-db path)
      (is (equal '("t") (mapcar (lambda (s) (getf s :name)) (show-sequences))))
      (is (= 50 (next-value "t"))))))

;;; Views

(defun make-view-world ()
  (make-sample-people)
  (create-view "adults" :from "people" :where '(>= :age 30) :col '(:id :name :age) :order-by :id))

(def-test view-is-queried-like-a-table (:fixture clean-db)
  (make-view-world)
  (is (equal '("ann" "cat" "Eve") (names-of "adults")))
  (is (equal '("ann" "cat") (names-of (select :from "adults" :where '(< :age 40) :order-by :id))))
  (is (equal '(:id :name :age) (mapcar #'name (schema (find-table "adults")))))
  (is (equal '("ann") (names-of (select :from "adults" :where (matching "adults" :id 1)))))
  (is (equal '("people") (show-tables)) "a view is not a table"))

(def-test view-shows-the-data-of-the-moment (:fixture clean-db)
  (make-view-world)
  (insert-row '(:name "zed" :age 99) "people")
  (update-row 2 '(:age 31) "people")
  (is (equal '("ann" "bob" "cat" "Eve" "zed") (names-of "adults")))
  (delete-row 1 "people")
  (is (equal '("bob" "cat" "Eve" "zed") (names-of "adults"))))

(def-test view-can-hold-grouping-and-joins (:fixture clean-db)
  (make-pet-world)
  (create-view "pet-counts" :from "people" :left-join '("pets" :id :owner)
                            :group-by :name :col '(:name (as (count :pet) :pets)))
  (is (equal '(("ann" 2) ("bob" 0) ("cat" 1))
             (mapcar (lambda (r) (list (getf r :name) (getf r :pets)))
                     (row-list (select :from "pet-counts" :order-by :name)))))
  (create-view "busy" :from "pet-counts" :where '(>= :pets 1))
  (is (equal '("ann" "cat") (names-of (select :from "busy" :order-by :name))) "a view of a view"))

(def-test view-in-a-join-and-explain (:fixture clean-db)
  (make-pet-world)
  (create-view "owners" :from "people" :where '(is-not-null :age))
  (is (equal '(("ann" "rex") ("ann" "tom") ("cat" "kit"))
             (joined :from "pets" :inner-join '("owners" :owner :id))))
  (is (equal :scan (second (first (explain :from "owners"))))))

(def-test views-cannot-be-changed (:fixture clean-db)
  (make-view-world)
  (signals schema-error (insert-row '(:name "x") "adults"))
  (signals schema-error (update-row 1 '(:age 1) "adults"))
  (signals schema-error (delete-row 1 "adults"))
  (signals schema-error (update-where "adults" '(:age 1) :where t))
  (signals schema-error (create-index "adults" :age))
  (signals schema-error (add-column "adults" '(:x number)))
  (signals schema-error (drop-table "adults")))

(def-test view-errors (:fixture clean-db)
  (make-sample-people)
  (signals schema-error (create-view "v"))
  (signals no-such-column (create-view "v" :from "people" :where '(= :nope 1)))
  (signals no-such-table (create-view "v" :from "nope"))
  (create-view "v" :from "people")
  (signals schema-error (create-view "v" :from "people"))
  (signals schema-error (create-view "people" :from "people"))
  (signals table-exists (make-table "v" '((:a number))))
  (signals schema-error (create-sequence "v"))
  (is-true (drop-view "v"))
  (is-false (drop-view "v"))
  (signals no-such-table (select :from "v")))

(def-test view-follows-a-dropped-table-with-an-error (:fixture clean-db)
  (make-sample-people)
  (create-view "v" :from "people")
  (drop-table "people")
  (signals no-such-table (select :from "v")))

(def-test show-views-lists-them (:fixture clean-db)
  (make-sample-people)
  (create-view "a" :from "people" :limit 2)
  (is (equal '((:name "a" :query (:from "people" :limit 2))) (show-views))))

(def-test view-changes-roll-back (:fixture clean-db)
  (make-sample-people)
  (with-transaction (create-view "v" :from "people") (rollback))
  (is (null (show-views)))
  (create-view "v" :from "people")
  (with-transaction (drop-view "v") (rollback))
  (is (= 1 (length (show-views)))))

(def-test views-survive-snapshot-log-and-checkpoint (:fixture clean-db)
  (make-view-world)
  (call-with-temp-file
    (lambda (path)
      (save-db path)
      (clear-db)
      (load-db path)))
  (is (equal '("ann" "cat" "Eve") (names-of "adults")))
  (with-temp-dir (dir)
    (let ((path (merge-pathnames "t.db" dir)))
      (clear-db)
      (open-db path)
      (make-sample-people)
      (create-view "old" :from "people" :where '(> :age 29))
      (create-view "gone" :from "people")
      (drop-view "gone")
      (restart-db path)
      (is (equal '("old") (mapcar (lambda (v) (getf v :name)) (show-views))) "from the log")
      (is (= 3 (count-rows "old")))
      (checkpoint)
      (restart-db path)
      (is (= 3 (count-rows "old")) "from the snapshot"))))

(def-test view-with-a-lambda-cannot-be-saved (:fixture clean-db)
  (make-sample-people)
  (create-view "v" :from "people" :where (lambda (r) (eql 30 (getf r :age))))
  (is (= 2 (count-rows "v")))
  (call-with-temp-file
    (lambda (path)
      (signals persistence-error (save-db path))))
  (with-temp-dir (dir)
    (clear-db)
    (open-db (merge-pathnames "t.db" dir))
    (make-sample-people)
    (signals persistence-error
      (create-view "w" :from "people" :where (lambda (r) (eql 30 (getf r :age)))))
    (is (null (show-views)) "the failed commit left no view")))
